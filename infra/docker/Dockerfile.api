# Production image for apps/api (the worker uses the same image with a different command).
FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @places/api... build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production TZ=Africa/Cairo
COPY --from=build /app .
USER node
CMD ["node", "apps/api/dist/main.js"]
