// Places ERP — database schema. One PostgreSQL database, one schema per business area (comments mark the M-xx module).
// Conventions: ids are cuid strings · money is Decimal(14,2) EGP (the domain package works in integer piasters) ·
// every table has createdAt/updatedAt · nothing business-relevant is hard-deleted (archivedAt) · times are UTC.

generator client {
  provider = "prisma-client-js"
}

// the connection string lives in prisma.config.ts (Prisma 7)
datasource db {
  provider = "postgresql"
  schemas = ["access", "sales", "inventory", "marketing", "hr", "ops", "finance", "kpi", "system"]
}

// ───────────────────────────── M-09 · users, roles, permissions ─────────────────────────────

enum AccountStatus {
  INVITED
  ACTIVE
  LOCKED
  DISABLED

  @@schema("access")
}

enum DataScope {
  OWN
  TEAM
  DEPT
  ALL

  @@schema("access")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  phone         String?
  passwordHash  String?       // argon2id; null until the invite is accepted
  status        AccountStatus @default(INVITED)
  failedLogins  Int           @default(0)
  otpRequired   Boolean       @default(false) // client decision 28/10: off for everyone, admin can turn it on per person
  emailNotifications Boolean  @default(true)  // M-14 «my preferences»: important ones always reach the bell anyway
  tokens        AuthToken[]
  lastLoginAt   DateTime?
  endDate       DateTime?     // last working day: the account stops by itself
  employee      Employee?
  roles         UserRole[]
  overrides     PermissionOverride[]
  sessions      Session[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@schema("access")
}

/// M-09 2.2 · 7.1: a leaver's open leads and tasks move to someone else once their direct manager approves.
model Handover {
  id         String    @id @default(cuid())
  fromUserId String    // the person leaving
  toUserId   String    // who gets the work
  byUserId   String    // who asked (HR / Super Admin)
  approverId String    // the leaver's direct manager's account when it was asked
  status     String    @default("pending") // pending · approved · rejected
  leads      Int?      // how many moved, once approved
  tasks      Int?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([approverId, status])
  @@index([fromUserId, status])
  @@schema("access")
}

model Session {
  id        String   @id // random 256-bit token hash
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@schema("access")
}

/// One-time secrets sent by email: account activation, password reset, sign-in OTP. Only the hash is stored.
model AuthToken {
  id        String        @id // sha256 of the token / of userId+code for OTP
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      AuthTokenKind
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, kind])
  @@schema("access")
}

enum AuthTokenKind {
  INVITE
  RESET
  OTP

  @@schema("access")
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique // admin, officemgr, sales, tl, … or a custom role
  label       String
  tier        String           // Super Admin · Office Manager · Department Head · Executive Staff …
  behavesLike String?          // a custom role reuses a built-in role's home page and inboxes
  builtIn     Boolean          @default(false) // the 18 roles from the requirements: can't be deleted
  scope       DataScope        @default(OWN)
  permissions RolePermission[]
  fieldRules  RoleFieldRule[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@schema("access")
}

model RolePermission {
  roleId  String
  role    Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module  String   // see MODULES in @places/domain
  actions String[] // view · create · edit · approve · delete · import · export

  @@id([roleId, module])
  @@schema("access")
}

/// M-09 field permissions: a field of a module this role sees read only or not at all (no row = shown)
model RoleFieldRule {
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module String // see FIELDS in @places/domain
  field  String
  mode   String // read · hide

  @@id([roleId, module, field])
  @@schema("access")
}

model UserRole {
  userId  String
  roleId  String
  primary Boolean @default(false)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@schema("access")
}

/// A per-person exception that replaces the person's roles for one module.
model PermissionOverride {
  userId  String
  module  String
  actions String[]
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, module])
  @@schema("access")
}

// ───────────────────────────── M-05 · employees, attendance, leave ─────────────────────────────

model Employee {
  id              String          @id @default(cuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id])
  name            String
  jobTitle        String
  department      String
  managerId       String?         // who follows this person (KPIs, approvals)
  manager         Employee?       @relation("Follows", fields: [managerId], references: [id])
  reports         Employee[]      @relation("Follows")
  teamLeaderId    String?         // sales teams A–D
  teamLeader      Employee?       @relation("SalesTeam", fields: [teamLeaderId], references: [id])
  teamMembers     Employee[]      @relation("SalesTeam")
  team            String?         // "A" · "B" · "C" · "D"
  salary          Decimal         @db.Decimal(14, 2)
  target          Decimal         @default(0) @db.Decimal(14, 2)
  commissionPct   Decimal         @default(0) @db.Decimal(5, 2) // the scheme, e.g. 30
  partTime        Boolean         @default(false)
  partTimeDeductions Boolean      @default(false) // M-05 3.1: HR decides if a part-timer has deductions
  joinedAt        DateTime?
  deductionTiers  Json?           // per-person tiers (Q33); null = company default
  fixedSchedule   String?         // e.g. CFO: Mon & Thu 17:00–19:00
  leaveBalance    Int             @default(21)
  attendance      AttendanceDay[]
  leaves          LeaveRequest[]
  penalties       Penalty[]
  oneOnOnes       OneOnOne[]
  dealParts       DealParticipant[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  kpiCards        KpiCard[]       @relation("KpiOwner")
  kpiFollowing    KpiCard[]       @relation("KpiFollower")
  salesActivities SalesActivity[]
  @@schema("hr")
}

enum AttendanceKind {
  CHECKIN
  EXCUSE
  VISIT
  OUTSIDE_APPROVED
  FORGOT
  ABSENT
  SPECIAL_SCHEDULE

  @@schema("hr")
}

model AttendanceDay {
  id               String         @id @default(cuid())
  employeeId       String
  employee         Employee       @relation(fields: [employeeId], references: [id])
  day              DateTime       @db.Date
  checkInAt        DateTime?
  checkOutAt       DateTime?
  visitAt          DateTime?      // 7.3: the Visit that started a salesperson's day; HR sees it next to the real fingerprint
  kind             AttendanceKind @default(CHECKIN)
  deduction        Decimal        @default(0) @db.Decimal(3, 2) // 0 · 0.25 · 0.5 · 1
  lateMinutes      Int            @default(0)
  hrConfirmed      Boolean        @default(false)
  source           String         // device · sheet · system
  createdAt        DateTime       @default(now())

  @@unique([employeeId, day]) // the same sheet uploaded twice never duplicates a day
  @@schema("hr")
}

enum LeaveStatus {
  PENDING_TL
  APPROVED_BY_TL
  REJECTED
  CLOSED_BY_HR

  @@schema("hr")
}

model LeaveRequest {
  id           String      @id @default(cuid())
  employeeId   String
  employee     Employee    @relation(fields: [employeeId], references: [id])
  type         String
  fromDay      DateTime    @db.Date
  toDay        DateTime    @db.Date
  reason       String?
  status       LeaveStatus @default(PENDING_TL)
  rejectReason String?
  /// M-05 7.5: days counted, the document (sick / emergency), who decides at each step, the 24 / 48-hour chase
  days         Int         @default(0)
  documentId   String?
  tlUserId     String?     // the Team Leader (or manager) who decides first; null = straight to HR
  tlDecidedAt  DateTime?
  hrUserId     String?
  closedAt     DateTime?
  remindedAt   DateTime?
  escalatedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([employeeId, createdAt]) // 13.3: an employee's leaves, newest first
  @@index([status])
  @@schema("hr")
}

model Penalty {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  day        DateTime @db.Date
  text       String
  byUserId   String
  /// M-05 7.7: the deduction in days, and HR's approval (a TL's proposal waits for it)
  deductionDays Decimal @default(0) @db.Decimal(4, 2)
  status     String   @default("approved") // pending · approved · rejected
  approvedById String?
  decidedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([day])
  @@schema("hr")
}

/// M-05 (32) · 7.9: HR approves the month's deductions once; payroll (9.14) reads these numbers, not the live ones.
model DeductionApproval {
  id           String   @id @default(cuid())
  month        String   @unique // 2026-11
  lines        Json     // [{ userId, employeeId, attendanceDays, penaltyDays, amount }] · amount as a decimal string
  approvedById String
  at           DateTime @default(now())

  @@schema("hr")
}

model OneOnOne {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  heldOn      DateTime  @db.Date
  answers     Json
  hrAction    String?
  hrActionDue DateTime? @db.Date
  hrActionDone Boolean  @default(false)
  /// M-05 7.8: who held it, and when «حل الـ HR» rang (once)
  byUserId    String?
  alarmedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([employeeId, heldOn]) // 13.3: an employee's 1:1 history
  @@schema("hr")
}

// ───────────────────────────── M-01 · leads & companies ─────────────────────────────

/// A lead is a client or a broker (client meeting 4 Nov · 1.28).
enum LeadKind {
  CLIENT
  BROKER

  @@schema("sales")
}

enum LeadStage {
  FRESH
  INTERESTED
  NOT_INTERESTED
  NO_ANSWER
  FOLLOW_UP_TO_VISIT
  VISIT
  FOLLOW_UP_AFTER_VISIT
  FOLLOW_UP_TO_MEETING
  MEETING
  FOLLOW_UP_AFTER_MEETING
  NEAR_TO_CLOSE
  DONE_DEAL
  CANCELLATION
  HOLD

  @@schema("sales")
}

model Lead {
  id             String        @id @default(cuid())
  code           String        @unique // L-1001…
  name           String
  companyId      String?
  company        Company?      @relation(fields: [companyId], references: [id])
  phones         String[]
  area           String
  type           String        // Rent · Resale · Primary · Income
  space          Int?
  condition      String?
  budget         Decimal?      @db.Decimal(14, 2)
  channel        String
  campaignId     String?
  campaign       Campaign?     @relation(fields: [campaignId], references: [id])
  stage          LeadStage     @default(FRESH)
  kind           LeadKind      @default(CLIENT) // client meeting 4 Nov (1.28): brokers have their own tab, same stages
  selfEntered    Boolean       @default(false)  // the salesperson entered it himself (KPI 11.15)
  qualified      Boolean       @default(false) // sticky, see isQualifiedAfter
  assignedToId   String?
  assignedAt     DateTime?
  touched        Boolean       @default(false)
  ownedByTelesales Boolean     @default(false)
  noAnswerCount  Int           @default(0)
  rotation       Int           @default(1)  // how many salespeople it went through on No Answer; the 3rd goes to Telesales (M-01 3.2)
  arrivedAt      DateTime      @default(now()) // KPI: first call within 30 min · the campaign WhatsApp message time if it came that way
  firstCallAt    DateTime?     // KPI: the first call within 30 minutes of arrivedAt (domain firstCallOnTime)
  firstActionAt  DateTime?     // the salesperson's first action (comment, call, stage change…): stops the SLA clock (M-01 «من غير أي أكشن»)
  slaWarnedAt    DateTime?     // the TL got the 2h30 warning for this assignment (cleared on reassign)
  naMarkedById   String?       // the employee who marked it No Answer: only the salesperson's own mark moves it (1.17)
  naMarkedAt     DateTime?     // the No Answer 24 hours count from here (4 Nov meeting)
  naRemindedAt   DateTime?     // the last «كلّم …» Alarm while in No Answer: the next one 4 working hours later (1.18)
  draft          String?       // in a Draft tab (1.26 · 1.27): "draft" · "admin"; null = with its salesperson. The open LeadDraft says more
  newLeadRequestedAt   DateTime? // Telesales sent it as a New Lead (1.17): Operations' queue · KPI 11.15 «توزيع الـ New Lead في ميعاده»
  newLeadRequestedById String?
  newLeadRoutedAt      DateTime? // Operations sent it on; null while the request waits
  newLeadRoutedById    String?
  note           String?
  post           String?       // the campaign post it came from (M-04: channel → campaign → post)
  answers        Json?         // answers to the recommendation questions, they narrow the suggested units
  verification   Json?         // Second Call (11.15): { called, sent, note, byUserId, at }
  activities     LeadActivity[]
  arrivals       LeadArrival[]
  calls          LeadCall[]
  duplicates     LeadDuplicate[]
  companyRequests CompanyRequest[] // 1.20: its company isn't in the sheet yet
  visits         LeadVisit[]
  drafts         LeadDraft[]
  suggestedUnits LeadUnit[]
  deals          Deal[]
  clientId       String?       // the client file it belongs to (M-10 2.1 / 2.3: Done Deal, or an old client's number)
  client         Client?       @relation(fields: [clientId], references: [id])
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  archivedAt     DateTime?

  @@index([clientId])
  @@index([assignedToId, stage])
  @@index([kind])
  @@index([area])
  @@index([createdAt])
  @@index([phones], type: Gin) // the duplicate check on every new lead
  @@schema("sales")
}

/// A lead's stay in a Draft tab (1.26 Draft · 1.27 Draft Admin): when it came, from whom, and Operations' decision.
/// Open while decidedAt is null; the times feed Operations' KPI item «قرارات الـ Draft في ميعادها» (11.15).
model LeadDraft {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind        String    // draft · admin
  at          DateTime  @default(now())
  fromId      String?   // the employee who had it
  stage       String    // the stage it came in with (LeadStage, db spelling)
  days        Int?      // draft: the idle days that pulled it (7, or 14 on Hold)
  keptAt      DateTime? // «يفضل في الـ Draft»: reviewed, stays (the first decision, for the KPI)
  keptById    String?
  decidedAt   DateTime? // sent to someone: the stay ends
  decidedById String?
  decision    String?   // rotation · hand · back (to the same salesperson) · telesales
  toId        String?   // the employee it went to

  @@index([kind, decidedAt])
  @@index([leadId])
  @@schema("sales")
}

/// Visits and meetings (M-01 3.3 «Visit»): the time, the units shown, an alarm at the time, then Done / not done.
model LeadVisit {
  id        String      @id @default(cuid())
  leadId    String
  lead      Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind      String      @default("visit") // visit · meeting
  at        DateTime
  extra     String?     // spaces that aren't in the inventory sheet yet («دور 4 في مبنى B6»)
  outcome   String?     // done · not_done (not done shows for HR in attendance, M-07); null = still planned
  alarmedAt DateTime?   // the salesperson got the Alarm at its time (the worker sends it once; editing the time sends it again)
  // 1.24 «اتأجلت»: pending · approved · rejected; approved = that day without a deduction (7.3)
  postponeStatus      String?
  postponeReason      String?
  postponeRequestedBy String?
  postponeDecidedBy   String?
  postponeDecidedAt   DateTime?
  units     VisitUnit[]
  byUserId  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([leadId, at])
  @@index([at]) // the alarm job: visits due now and not marked
  @@schema("sales")
}

model VisitUnit {
  visitId String
  visit   LeadVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  unitId  String
  unit    Unit      @relation(fields: [unitId], references: [id])

  @@id([visitId, unitId])
  @@schema("sales")
}

/// Units the salesperson picked for this client from the inventory (with the recommendations, M-01 3.2).
model LeadUnit {
  leadId   String
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  unitId   String
  unit     Unit     @relation(fields: [unitId], references: [id])
  byUserId String
  at       DateTime @default(now())

  @@id([leadId, unitId])
  @@index([unitId])
  @@schema("sales")
}

/// Every time a lead reaches us — the first time and every duplicate — counted for its channel / campaign
/// (M-04 Q22: «الليد المكرر بيتحسب كل مرة»). The lead's own channel is the one that gets the credit.
model LeadArrival {
  id         String         @id @default(cuid())
  leadId     String
  lead       Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel    String
  campaignId String?
  campaign   Campaign?      @relation(fields: [campaignId], references: [id])
  duplicate  Boolean        @default(false)
  byUserId   String?        // null = imported / the system
  at         DateTime       @default(now())
  review     LeadDuplicate?

  @@index([leadId])
  @@index([campaignId, at])
  @@index([channel, at])
  @@schema("sales")
}

/// 1.19 «إدخال جماعي»: a sheet of mobiles Telesales sends; Operations takes salespeople out, then approves (the new
/// numbers become leads given in turn over today's order, M-01 3.2) or rejects with a reason.
model LeadBulk {
  id          String    @id @default(cuid())
  numbers     String[]  // the mobiles, each once, as the leads keep them
  channel     String
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  status      String    @default("pending") // pending · approved · rejected
  excluded    String[]  // employee ids Operations took out of this distribution («شيله»)
  reason      String?   // why it was rejected
  byUserId    String
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
  @@schema("sales")
}


/// A lead entered again with a mobile we already have. Operations compares both and chooses what stays and which
/// channel gets the credit (M-01 Q7). `data` is what was entered; `decision` what Operations chose.
model LeadDuplicate {
  id          String      @id @default(cuid())
  leadId      String
  lead        Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  arrivalId   String      @unique
  arrival     LeadArrival @relation(fields: [arrivalId], references: [id], onDelete: Cascade)
  data        Json
  byUserId    String
  at          DateTime    @default(now())
  decidedAt   DateTime?
  decidedById String?
  decision    Json?

  @@index([decidedAt])
  @@schema("sales")
}

/// Every call a salesperson or Telesales logs on a lead (M-01 3.1): the KPIs count them (Telesales 100 a day,
/// sales 50 a week) and the first one is measured against the lead's arrival (30 minutes).
model LeadCall {
  id       String   @id @default(cuid())
  leadId   String
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  byUserId String
  at       DateTime @default(now())

  @@index([byUserId, at])
  @@index([leadId, at])
  @@schema("sales")
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind      String   // call · stage · comment · visit · meeting · whatsapp
  text      String
  byUserId  String?  // null = the system
  at        DateTime @default(now())

  @@index([leadId, at])
  @@schema("sales")
}

model Company {
  id                 String   @id @default(cuid())
  name               String
  category           String   // 63 categories (M-13 list)
  number             String?
  contactName        String?
  contactTitle       String?
  email              String?
  currentLocation    String?
  currentSpace       Int?
  contractStart      DateTime? @db.Date
  contractEnd        DateTime? @db.Date
  averageRent        Decimal?  @db.Decimal(14, 2)
  annualEscalation   Decimal?  @db.Decimal(5, 2)
  feedback           String?
  outbound           Boolean   @default(false) // added by Telesales herself (KPI)
  contactedOn        DateTime? @db.Date // the sheet's «date»: the last contact or when it was added
  createdById        String?   // who added it (the Outbound KPI counts Telesales' own, 1.20)
  leads              Lead[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([name, number])
  @@schema("sales")
}

/// 1.20 · a company written on a lead that isn't in «شيت الشركات» (M-01 2.1, 6.1): Telesales adds it with its category.
model CompanyRequest {
  id        String   @id @default(cuid())
  name      String
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  byUserId  String
  status    String   @default("pending") // pending · added
  companyId String?
  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@schema("sales")
}


// ───────────────────────────── M-02 · deals, collections, TCR ─────────────────────────────

enum DealStatus {
  PENDING_REVIEW
  APPROVED
  PARTIALLY_COLLECTED
  FULLY_COLLECTED
  REJECTED
  CANCELLED

  @@schema("sales")
}

/// M-02 3.1 «type»: the four kinds of deal on the done-deals sheet.
enum DealType {
  Rent
  Resale
  Primary
  Income

  @@schema("sales")
}

model Deal {
  id               String            @id @default(cuid())
  code             String            @unique // D-301…
  leadId           String?
  lead             Lead?             @relation(fields: [leadId], references: [id])
  unitId           String
  unit             Unit              @relation(fields: [unitId], references: [id])
  type             DealType
  space            Int
  location         String
  company          String            // M-02 3.1 «company»: the client's company when the deal was registered (the lead's name if none)
  source           String            // M-02 3.1 «source»: the lead's channel
  status           DealStatus        @default(PENDING_REVIEW)
  commissionOwner  Decimal           @db.Decimal(14, 2)
  commissionClient Decimal           @db.Decimal(14, 2)
  targetBase       Decimal?          @db.Decimal(14, 2) // «note» override, target only
  externalCommission Decimal?        @db.Decimal(14, 2) // 9.6: written on the review; null = the external % setting
  note             String?
  offTarget        Boolean           @default(false)    // created and closed within a day (Q13)
  closedAt         DateTime
  execDueAt        DateTime?         @db.Date
  executedAt       DateTime?         @db.Date
  papersOk         Boolean?          // Finance's check of contract · mandate · registration
  papersNote       String?
  reviewedById     String?           // the Office Manager who approved or rejected it (Q9)
  reviewedAt       DateTime?
  reviewNote       String?           // why it went back to the salesperson (Q9)
  cancelledAt      DateTime?         // Q12: a cancelled deal drops out of revenue, targets and commissions
  cancelNote       String?
  participants     DealParticipant[]
  payments         Payment[]
  tcrs             Tcr[]
  payouts          CommissionPayout[]
  contract         Contract?
  unitLocks        UnitLock[]
  createdById      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status])
  @@index([leadId])
  @@index([unitId])
  @@schema("sales")
}

enum DealSide {
  BUYER
  SELLER

  @@schema("sales")
}

model DealParticipant {
  dealId     String
  employeeId String
  side       DealSide
  approved   Boolean  @default(true) // the Seller waits for Manar's approval
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@id([dealId, employeeId])
  @@index([employeeId])
  @@schema("sales")
}

model Payment {
  id          String   @id @default(cuid())
  dealId      String
  deal        Deal     @relation(fields: [dealId], references: [id])
  side        String   // owner · client
  amount      Decimal  @db.Decimal(14, 2)
  receivedAt  DateTime // the day it showed in the account (KPI: commission the same day)
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  recordedById String
  tcr         Tcr?
  createdAt   DateTime @default(now())

  @@schema("sales")
}

model Tcr {
  id         String         @id @default(cuid())
  code       Int            @unique // T180, T181 … one sequence for the company
  dealId     String
  deal       Deal           @relation(fields: [dealId], references: [id])
  paymentId  String         @unique
  payment    Payment        @relation(fields: [paymentId], references: [id])
  signatures TcrSignature[]
  payouts    CommissionPayout[]
  pdfKey     String?        // file in object storage
  createdAt  DateTime       @default(now())

  @@schema("sales")
}

/// 9.15: «صرف عمولة سيلز» — what was paid to a salesperson on a deal against its TCR; no deal = a Team Leader's commission (5.8).
model CommissionPayout {
  id          String   @id @default(cuid())
  employeeId  String
  dealId      String?
  deal        Deal?    @relation(fields: [dealId], references: [id])
  tcrId       String?
  tcr         Tcr?     @relation(fields: [tcrId], references: [id])
  amount      Decimal  @db.Decimal(14, 2)
  moveId      String   @unique // the voucher (finance.TreasuryMove)
  createdById String
  createdAt   DateTime @default(now())

  @@index([employeeId])
  @@index([dealId])
  @@schema("sales")
}

model TcrSignature {
  tcrId      String
  employeeId String
  signedAt   DateTime?
  tcr        Tcr       @relation(fields: [tcrId], references: [id], onDelete: Cascade)

  @@id([tcrId, employeeId])
  @@schema("sales")
}

// ───────────────────────────── M-10 · clients & owners ─────────────────────────────

/// M-10 3.1 «النوع»: set by the system — a Done Deal makes a client, a first unit makes an owner, both = the same person.
enum ClientKind {
  client
  owner
  both

  @@schema("sales")
}

/// M-10 3.3: Active while we deal with them, Inactive after a year without any (the system moves it).
enum ClientStatus {
  active
  inactive

  @@schema("sales")
}

/// M-10: one file per client or owner, with their leads, units (→ deals → contracts) and every interaction.
model Client {
  id               String              @id @default(cuid())
  name             String              // «الاسم / الشركة»
  company          String?
  kind             ClientKind
  status           ClientStatus        @default(active)
  preferredContact String?             // M-10 2.1 step 3: «طريقة التواصل المفضّلة»
  lastContactAt    DateTime            @default(now()) // last interaction / deal / unit: a year before now = Inactive (M-10 3.3)
  phones           ClientPhone[]
  interactions     ClientInteraction[]
  leads            Lead[]              // the leads they came as (a returning client's new lead joins the file, M-10 2.3)
  units            Unit[]              // the units they own (deals on them and the contracts follow from the units / leads)
  createdById      String?
  mergedIntoId     String?             // merged into another file by Operations (M-10 2.2); archived with it
  marketingConsent Boolean?            // M-10 3.1 «موافقة على التواصل التسويقي»: اه / لا, null = not asked yet
  deletionAskedAt  DateTime?           // M-10 2.3: the client asked to erase their data → to management (data protection)
  deletionAskedBy  String?             // access.User who filed it
  deletionReason   String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  archivedAt       DateTime?

  @@index([kind])
  @@index([name])
  @@index([status, lastContactAt])
  @@schema("sales")
}

/// M-10 2.2: merging two files of the same person waits for Operations' approval; the dropped file moves into the kept one.
enum ClientMergeStatus {
  pending
  approved
  rejected

  @@schema("sales")
}

model ClientMerge {
  id            String            @id @default(cuid())
  keepId        String            // sales.Client that stays
  dropId        String            // sales.Client that moves into it
  status        ClientMergeStatus @default(pending)
  reason        String            // why: the shared number, or who asked
  suggestedById String?           // null = the system (a deal / unit whose numbers are on two files)
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime          @default(now())

  @@index([status])
  @@schema("sales")
}

/// A file's numbers, normalized (domain normalizePhone): one number belongs to one file only (M-10 3.1 «بتمنع التكرار»).
model ClientPhone {
  phone     String   @id
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([clientId])
  @@schema("sales")
}

/// M-10 2.1 step 5: a call, a visit, a complaint, a request… (kinds from the «أنواع التواصل مع العميل» list).
model ClientInteraction {
  id       String   @id @default(cuid())
  clientId String
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kind     String
  text     String
  byId     String   // access.User
  at       DateTime @default(now())

  @@index([clientId, at])
  @@schema("sales")
}

// ───────────────────────────── M-03 · inventory & Not Active ─────────────────────────────

/// M-03 3.1: the unit's sheet. Rent · Resale · Income each have their own columns (sources/inventory-unit-fields.md).
/// Primary is in the client's KPIs (Randa enters «Resale / Primary» units) but its own columns weren't sent yet,
/// so it has the common ones only (needs-client).
enum UnitType {
  Rent
  Resale
  Income
  Primary

  @@schema("inventory")
}

/// rented / sold units move to the «rented» sheet (M-03 1.3, 5.2)
enum UnitStatus {
  available
  rented
  sold

  @@schema("inventory")
}

model Unit {
  id                String      @id @default(cuid())
  code              String      @unique // U-101… from inventory.unit_code_seq (M-03 3.2: serial codes)
  type              UnitType
  alsoType          UnitType?   // available as a second type at the same time (M-03 Q17)
  status            UnitStatus  @default(available)
  alsoStatus        UnitStatus? // closing one side leaves the other open (Q17)
  // 2.21: no column is required (the client's sheet has gaps); empty = "" / 0 until filled (domain missingFields)
  project           String      @default("") // Rent «project» · Resale / Income «اسم المبنى»
  area              String      @default("")
  space             Int         @default(0) // gross area, m²
  condition         String      @default("") // Rent «conditions» · Resale «التشطيب»
  floor             String?
  building          String?     // «build num» / «رقم المبنى» (number and text)
  parking           Int         @default(0)
  ownerName         String?     // Rent «contact» · Resale «اسم الأونر» · Income «الاسم»
  ownerPhone        String?     // «number»: the owner's number (Not Active sheets are compared by it, M-03 1.1)
  ownerId           String?     // the owner's file (M-10 2.1 step 4: every unit linked to its owner)
  owner             Client?     @relation(fields: [ownerId], references: [id])
  pricePerSqm       Decimal?    @db.Decimal(14, 2) // Rent: rent per m² · Resale / Income: sale price per m²
  totalPrice        Decimal?    @db.Decimal(14, 2) // pricePerSqm × space, written by the domain on every save (filters by price)
  leasePerSqm       Decimal?    @db.Decimal(14, 2) // Income: lease price per m²
  maintenance       String?     // number and text
  commission        String?     // number and text
  paymentMethod     String?     // Resale / Income
  layout            Boolean     @default(false) // «Layout» Yes / No (Book7, 2.21)
  comment           String?     // «Comment» (Book7, 2.21)
  details           Json        @default("{}") // the columns only one type has (Resale delivery, Income contract…), checked by @places/contracts
  agentId           String?     // hr.Employee: who brought the unit → Seller on a deal (M-02), counted in their activity
  divisible         Boolean     @default(false)
  minSplit          Int?        // the smallest part it can be split into (M-03 3.1)
  splitNote         String?     // what the split is (Q20: Manar writes it)
  areaTabId         String?     // the area tab Manar picked (M-03 3.2); null = by its area
  areaTab           AreaTab?    @relation(fields: [areaTabId], references: [id], onDelete: SetNull)
  location          String?     // "lat, lng" picked on the map
  pdfStatus         String      @default("draft") // draft · confirmed (Manar, Q15/Q19)
  receivedAt        DateTime?   // KPI: entered within 24h of receiving it
  enteredAt         DateTime    @default(now())
  mediaUrl          String?
  mediaUploadedAt   DateTime?
  lastOwnerUpdateAt DateTime    @default(now()) // «last update»: older than a month = late (M-03 2.4)
  marketingDoneAt   DateTime?   // marketing pressed Done on the new unit: off the marketing board (M-03 6.2 · 7.1, M-04 4.4)
  createdById       String?     // the user who entered it (Manar / Randa activity)
  deals             Deal[]
  locks             UnitLock[]
  photos            UnitPhoto[]
  suggestedFor      LeadUnit[]
  shownInVisits     VisitUnit[]
  tasks             Task[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  archivedAt        DateTime?

  @@index([type, status])
  @@index([area])
  @@index([space])
  @@index([totalPrice])
  @@index([ownerPhone])
  @@index([ownerId])
  @@index([areaTabId])
  @@schema("inventory")
}

/// M-03 Q16 · Q17 · a Done Deal on one side of a unit (Rent, or Resale / Income): pending until Manar (Rent) or Randa
/// (the rest) confirms, then that side is rented / sold. Released (deleted, the audit keeps it) when the deal is
/// cancelled or its contract ends (6.4).
model UnitLock {
  id            String    @id @default(cuid())
  unitId        String
  unit          Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  dealId        String
  deal          Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  type          UnitType  // the deal's type = the side it closes
  status        String    @default("pending") // pending · locked
  requestedAt   DateTime  @default(now())
  requestedById String?
  lockedAt      DateTime? // when Manar / Randa confirmed: the unit's «rented / sold» date (2.10)
  lockedById    String?

  @@unique([unitId, dealId])
  @@unique([unitId, type]) // one Done Deal per side at a time: a second one waits until the first is released
  @@index([status, lockedAt])
  @@schema("inventory")
}

/// M-03 1.2 · 3.1 «pic or info»: the unit's photos, uploaded into the system instead of the Drive (core/files), in the
/// order Manar / Randa set; the first one is the main photo (the card, the PDF).
model UnitPhoto {
  id        String   @id @default(cuid())
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  fileId    String   @unique // system.File (entity "Unit")
  position  Int      // the folder's order; the first image is the main photo (the PDF's cover)
  pdf       Boolean  @default(false) // 2.22: a PDF in the «Pic & Info» folder, never a cover or a brochure photo
  createdAt DateTime @default(now())

  @@index([unitId, position])
  @@schema("inventory")
}

/// M-03 3.1 · 2.18 · the inventory's daily report: made by the reports engine (11.10, content «inventory») at its time,
/// Manar approves it (the approval time is her KPI, M-12) and then its recipients get it.
model InventoryReport {
  id           String    @id @default(cuid())
  reportId     String?   // kpi.ScheduledReport that made it (its time and people are set in «التقارير ومواعيدها»)
  sendTo       String[]  // the report's recipients when it was made: told once Manar approves
  day          DateTime  @unique @db.Date // the Cairo day it counts
  newUnits     Int       // «جديد»: entered that day
  updated      Int       // «متحدّث»: owner update that day
  closed       Int       // «اتأجر / اتباع»: closes Manar / Randa confirmed that day
  unconfirmed  Int       // «مش مؤكد»: open units a month without an update or with a PDF waiting, when it was counted
  generatedAt  DateTime  @default(now())
  approvedAt   DateTime?
  approvedById String?

  @@schema("inventory")
}

/// M-03 7.2 · the area tabs under the list (101 to 200 …): the inventory team adds, edits and removes them (12.8).
model AreaTab {
  id        String   @id @default(cuid())
  min       Int
  max       Int?     // null = and above («+800»)
  units     Unit[]
  createdAt DateTime @default(now())

  @@schema("inventory")
}

model NotActiveSheet {
  id        String         @id @default(cuid())
  name      String         @unique // e.g. CFC
  dedupeBy  String         // column used to merge without duplicates
  columns   String[]       @default([]) // the sheet's own headers, in order (its columns aren't fixed yet, M-03 3.1)
  numberBy  String?        // the «Number» column compared with the owners' numbers in the inventory (M-03 1.1)
  rows      NotActiveRow[]
  createdAt DateTime       @default(now())

  @@schema("inventory")
}

model NotActiveRow {
  id         String         @id @default(cuid())
  sheetId    String
  sheet      NotActiveSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  data       Json
  dedupeKey  String
  status     String?        // No Answer · Not True · Done
  feedback   String?        // required for Not True
  assignedTo String?        // the user Manar sent the row to as a task (Marwa, M-03 1.1)
  unitId     String?        // the unit created when Done
  matchedUnitId String?     // its number is an owner's number of this unit in the main inventory (M-03 1.1)
  matchSeen  Boolean        @default(false) // Manar set the matched row's status
  createdAt  DateTime       @default(now()) // rows are listed in the order they came in

  @@unique([sheetId, dedupeKey])
  @@index([sheetId, status])
  @@schema("inventory")
}

model ListRequest {
  id           String    @id @default(cuid())
  requestedBy  String    // Team Leader
  text         String
  unitCodes    String[]
  unconfirmed  Int       @default(0)
  doneById     String?
  doneAt       DateTime?
  createdAt    DateTime  @default(now())
  ticketId     String?   @unique // «طلب الـ List كتذكرة» (M-12 · ticket type «list»): its SLA, history and report

  @@index([requestedBy, createdAt])
  @@index([doneAt, createdAt])
  @@schema("inventory")
}

// ───────────────────────────── M-04 · marketing & tasks ─────────────────────────────

model Campaign {
  id        String   @id @default(cuid())
  name      String
  channel   String
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  budget    Decimal  @db.Decimal(14, 2)
  spent     Decimal  @default(0) @db.Decimal(14, 2) // what it actually cost (Finance / the cost center read it, 4.5)
  target    String?  // «المشروع / الوحدات المستهدفة»
  adUrl     String?
  note      String?
  leads     Lead[]
  arrivals  LeadArrival[]
  bulks     LeadBulk[]
  posts     Post[]
  createdAt DateTime @default(now())
  archivedAt DateTime? // archived, never deleted: leads point at it

  @@index([archivedAt])
  @@schema("marketing")
}

/// M-04 2.1 step 7: Rahma's Broadcast message (picture + text + logo, with the Hot Inventory units), sent to sales as a task.
model Broadcast {
  id          String          @id @default(cuid())
  text        String
  logo        Boolean         @default(true)
  hotUnitIds  String[]        // the Hot Inventory in the message (KPI M-12: twice a week with it)
  approved    Boolean         @default(true) // M-04 2.2: the marketing manager's review — false = waiting for it
  createdById String
  sends       BroadcastSend[]
  createdAt   DateTime        @default(now())

  @@index([createdAt])
  @@schema("marketing")
}

/// M-04 2.1 step 8 · 2.3 (24): a salesperson's Done / share, and the other units they broadcast that Rahma sees.
model BroadcastSend {
  id          String    @id @default(cuid())
  broadcastId String
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  userId      String
  otherUnits  String[]  // unit codes they also broadcast on their own
  doneAt      DateTime  @default(now())

  @@unique([broadcastId, userId])
  @@schema("marketing")
}

/// M-04 2.1 step 6 · 2.4: a post in the Content plan — its time, the Reminder at that time, the actual publish time.
model Post {
  id             String    @id @default(cuid())
  title          String    // the design / video
  channel        String
  campaignId     String?
  campaign       Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  at             DateTime  // when it is to be published (UTC)
  description    String?
  approved       Boolean   @default(true) // M-04 2.2: the manager's review is optional — false = waiting for it
  publishedAt    DateTime? // the actual publish time (KPI: on time ÷ planned)
  reminderSentAt DateTime? // the Reminder went out (once)
  createdById    String
  createdAt      DateTime  @default(now())
  archivedAt     DateTime?

  @@index([at])
  @@schema("marketing")
}

model Task {
  id        String    @id @default(cuid())
  kind      String    // a key of TASK_KINDS in @places/domain: photo · retouch · followup · toResale · marketing
  title     String?   // a marketing task's type («أنواع تاسكات التسويق»: Website leasing, Market survey…)
  unitId    String?
  unit      Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  byUserId  String?   // null = the system (the month job's follow-up, M-03 2.4)
  toUserId  String
  dueOn     DateTime  @db.Date
  status    String    @default("todo") // todo · progress · uploaded · done
  returned  Int       @default(0)      // sent back for changes (KPI: accepted first time)
  note      String?
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([toUserId, status])
  @@index([unitId])
  @@schema("marketing")
}

// ───────────────────────────── M-06 · tickets ─────────────────────────────

model Ticket {
  id           String        @id @default(cuid())
  number       Int           @unique @default(autoincrement()) // shown as TK-<number>
  type         String        // a key of TICKET_TYPES in @places/domain: request · hr_letter · dispute · list · purchase
  department   String        // a value of «أقسام التذاكر» (M-13); a transfer changes it, the events keep the history
  title        String
  priority     String        @default("normal") // normal · high
  status       String        @default("Open")   // Open · In Progress · Resolved · Closed
  fromUserId   String
  firstReplyAt DateTime?     // the department's first reply (M-06 3.2: response time)
  resolvedAt   DateTime?     // settled (Resolved, or Closed straight away): «اتقفلت في الـ SLA»
  closedAt     DateTime?
  escalatedAt  DateTime?     // M-06 2.4: the late ticket was escalated (once)
  events       TicketEvent[]
  createdAt    DateTime      @default(now())

  @@index([department, status])
  @@index([fromUserId])
  @@index([createdAt])
  @@schema("ops")
}

model TicketEvent {
  id       String   @id @default(cuid())
  ticketId String
  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  kind     String   // open · reply · status · transfer · close · escalate
  text     String
  byUserId String?  // null = the system (an escalation)
  at       DateTime @default(now())

  @@index([ticketId, at])
  @@schema("ops")
}

// ───────────────────────────── M-07 / M-08 · finance & procurement ─────────────────────────────

/// The chart of accounts (M-07, 4 Nov): the five fixed roots, the accountant's tree under them, and sub-accounts added later.
/// Safes and banks are accounts in the same tree (kind set). Balances are live: the sum of the journal lines.
model Account {
  id         String        @id @default(cuid())
  code       String        @unique // 1 · 11 · 111 · 11101 — a child's code starts with its parent's
  name       String
  parentId   String?
  parent     Account?      @relation("AccountTree", fields: [parentId], references: [id])
  children   Account[]     @relation("AccountTree")
  nature     String        // dr · cr (from the root: assets and expenses debit)
  kind       String?       // treasury · bank · wallet: the cash accounts vouchers pay from and into
  fixed      Boolean       @default(false) // the seeded chart: can't be removed
  cap        Decimal?      @db.Decimal(14, 2) // petty-cash ceiling
  /// the person a 131 (سلف) / 134 (عهد) sub-account belongs to (M-07 9.3)
  holderId   String?
  /// 9.12: whose own account it is — «client» (a client file under 113) or «sales» (an employee under 21103); one each
  partyType  String?
  partyId    String?
  budget     BudgetLine?
  movesFrom  TreasuryMove[] @relation("MoveFrom")
  movesTo    TreasuryMove[] @relation("MoveTo")
  movesOn    TreasuryMove[] @relation("MoveAccount")
  archivedAt DateTime?
  createdAt  DateTime      @default(now())
  payments   Payment[]
  lines      JournalLine[]
  purchases  Purchase[]    @relation("PurchaseLine")
  paidFor    Purchase[]    @relation("PurchasePaidFrom")

  @@index([parentId])
  @@unique([partyType, partyId])
  @@schema("finance")
}

/// One double-entry journal entry (M-07 9.5): every movement posts one, debit = credit.
model JournalEntry {
  id          String        @id @default(cuid())
  no          Int           @unique @default(autoincrement()) // shown as JV-<no>
  date        DateTime      // the day it counts for (UTC midnight of the Cairo day)
  nature      String        // صرف نقدية · توريد نقدية · تحويل · رصيد افتتاحي · قيد يدوي …
  source      String        // opening · manual · voucher …
  sourceId    String?
  memo        String
  createdById String
  createdAt   DateTime      @default(now())
  lines       JournalLine[]

  @@index([date])
  @@index([source, sourceId])
  @@schema("finance")
}

model JournalLine {
  id        String       @id @default(cuid())
  entryId   String
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String
  account   Account      @relation(fields: [accountId], references: [id])
  debit     Decimal      @default(0) @db.Decimal(14, 2)
  credit    Decimal      @default(0) @db.Decimal(14, 2)

  @@index([entryId]) // 13.3: an entry's lines (journal, ledger, every voucher) - Postgres doesn't index FKs itself
  @@index([accountId])
  @@schema("finance")
}

model BudgetLine {
  id        String     @id @default(cuid())
  name      String     @unique
  kind      String     // admin · selling
  budget    Decimal    @db.Decimal(14, 2)
  spent     Decimal    @default(0) @db.Decimal(14, 2)
  /// the expense account it budgets (M-07 9.2): spent = that account's movements inside the period
  accountId String?    @unique
  account   Account?   @relation(fields: [accountId], references: [id])
  period    String     @default("month") // month · quarter · year
  alert     Int        @default(80) // «نبّهني عند %»
  active    Boolean    @default(true)
  /// who answers for the line: gets its alerts with the accountant (9.9)
  ownerId   String?

  @@schema("finance")
}

/// M-08 · a purchase / payment request: Pending → Approved → Settled («اتسوّى» by procurement) → Posted (finance's
/// payment voucher, 10.2), or Rejected with the reason. Procurement never moves a balance (4 Nov meeting).
model Purchase {
  id           String    @id @default(cuid())
  no           Int       @unique @default(autoincrement()) // shown as PR-<no>
  item         String
  amount       Decimal   @db.Decimal(14, 2)
  /// the line: an expense account (5…) from the chart; its budget is the BudgetLine on that account
  accountId    String
  account      Account   @relation("PurchaseLine", fields: [accountId], references: [id])
  vendor       String?
  attachments  String[]  // File ids: a receipt or two quotes, required over 10,000 EGP
  status       String    @default("Pending") // Pending · Approved · Rejected · Settled · Posted
  decidedById  String?
  decidedAt    DateTime?
  rejectReason String?
  /// the cash account procurement says it paid from: a suggestion for finance
  paidFromId   String?
  paidFrom     Account?  @relation("PurchasePaidFrom", fields: [paidFromId], references: [id])
  settledById  String?
  settledAt    DateTime?
  moveId       String?   @unique // finance's payment voucher once posted
  move         TreasuryMove? @relation(fields: [moveId], references: [id])
  postedById   String?
  postedAt     DateTime?
  remindedAt   DateTime? // the approvers' one-working-day reminder went out (2.4)
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([createdById])
  @@index([accountId])
  @@schema("finance")
}

/// M-11 3.3: Active → (قرّب يخلص is computed: 90 days or less left) → Renewed · Ended · Terminated.
enum ContractStatus {
  ACTIVE
  RENEWED
  ENDED
  TERMINATED

  @@schema("finance")
}

model Contract {
  id           String         @id @default(cuid())
  code         String         @unique // C-501… from finance.contract_code_seq (M-11 3.1: serial)
  dealId       String         @unique
  deal         Deal           @relation(fields: [dealId], references: [id])
  startsOn     DateTime       @db.Date
  endsOn       DateTime       @db.Date
  value        Decimal        @db.Decimal(14, 2)
  escalation   Decimal        @default(0) @db.Decimal(5, 2) // yearly increase %
  status       ContractStatus @default(ACTIVE)
  fileId       String?        // the signed contract PDF (system.File «Contract»)
  renewalAlerts Int[]         @default([]) // which of the 90 / 60 / 30-day alerts went out (M-11 2.4)
  renewalLeadId String?        // the renewal lead the first alert opened (M-11 7.1)
  endedOn       DateTime?      @db.Date // terminated early or ran out (M-11 2.3 · 6.4)
  endReason     String?        // why it was terminated early
  penalty       Decimal?       @db.Decimal(14, 2) // the early-termination penalty (M-11 2.3)
  pendingValue  Decimal?       @db.Decimal(14, 2) // a value change waiting for management (M-11 2.2)
  pendingReason String?
  pendingById   String?
  pendingAt     DateTime?
  installments Installment[]
  createdById  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status, endsOn])
  @@schema("finance")
}

model Installment {
  id         String    @id @default(cuid())
  contractId String
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  dueOn      DateTime  @db.Date
  amount     Decimal   @db.Decimal(14, 2)
  paid       Decimal   @default(0) @db.Decimal(14, 2)
  alerts     String[]  @default([]) // which of reminder / late / escalated went out (M-11 2.4)
  payments   InstallmentPayment[]

  @@index([contractId, dueOn])
  @@index([dueOn])
  @@schema("finance")
}

/// M-11 2.1 step 4: a payment Finance records on an installment (part of it = Partially Paid, 2.3); each prints a receipt.
model InstallmentPayment {
  id            String      @id @default(cuid())
  installmentId String
  installment   Installment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  amount        Decimal     @db.Decimal(14, 2)
  paidOn        DateTime    @db.Date
  createdById   String
  createdAt     DateTime    @default(now())

  @@index([installmentId])
  @@index([paidOn])
  @@schema("finance")
}

// ───────────────────────────── M-12 · KPI cards ─────────────────────────────

/// One person's card for one quarter (M-12 3.1). followerId null = the owners follow it.
model KpiCard {
  id          String    @id @default(cuid())
  quarter     String    // "2026-Q4"
  employeeId  String
  employee    Employee  @relation("KpiOwner", fields: [employeeId], references: [id])
  followerId  String?
  follower    Employee? @relation("KpiFollower", fields: [followerId], references: [id])
  payBase     String    @default("bonus") // salary · bonus
  payPeriod   String    @default("quarter") // month · quarter
  payAmount   Decimal?  @db.Decimal(14, 2) // the bonus; null = one month's salary (11.4)
  approvedBy  String?
  approvedAt  DateTime?
  finalScore  Decimal?  @db.Decimal(6, 2) // saved when the quarter ends: the past quarters' results
  finalAmount Decimal?  @db.Decimal(14, 2)
  plan        String?   // improvement plan under 70%
  midAlertAt  DateTime? // 11.6: the mid-quarter check ran for this card (once)
  items       KpiItem[]

  @@unique([quarter, employeeId])
  @@schema("kpi")
}

/// One item of a card. Exactly where its number comes from (meeting 4 Nov · 11.11): `method` system (a metric key from
/// the catalog in @places/domain + its `params`: period, kind, minutes…), report (handed in: `report` names the report
/// that delivers it, null = «سلّمت» on the card; `required` times in the quarter) or manual (typed by `enteredBy`:
/// "follower", role keys or user ids). `key` stays when the item is renamed or copied to a new quarter (11.12).
model KpiItem {
  id         String        @id @default(cuid())
  key        String        @default(cuid())
  cardId     String
  card       KpiCard       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  position   Int
  title      String
  weight     Int
  targetText String
  source     String        @default("") // the client's «المصدر» column, as written
  method     String        // system · report · manual
  module     String?       // M-01…M-12, shown next to the method
  direction  String        @default("at-least") // at-least · at-most
  goal       Decimal       @db.Decimal(14, 2)
  metric     String?
  params     Json          @default("{}")
  enteredBy  String[]      @default(["follower"])
  report     String?
  required   Int?
  value      Decimal?      @db.Decimal(14, 2) // the manual entry, or the system's latest figure (the daily job, 11.5)
  baseline   Decimal?      @db.Decimal(14, 2) // October 2026's measure for the growth items
  deliveries KpiDelivery[]

  @@unique([cardId, position])
  @@schema("kpi")
}

model KpiBands {
  id         String @id @default("default")
  top        Int    @default(100)
  full       Int    @default(96)
  partial    Int    @default(70)
  low        Int    @default(50)
  rewardPct  Int    @default(15)
  cutPct     Int    @default(15)

  @@schema("kpi")
}

// ───────────────────────────── M-13 / M-14 · settings, notifications, audit ─────────────────────────────

/// Official holidays as ranges «من … لحد …» (an Eid is several days · 1.29); every day in between is off for the SLA.
model Holiday {
  id    String   @id @default(cuid())
  from  DateTime @db.Date
  to    DateTime @db.Date
  label String

  @@index([from])
  @@schema("system")
}

model Setting {
  key       String   @id // areas, channels, companyCategories, slaRules, deductionTiers, approvalLimit…
  value     Json
  updatedAt DateTime @updatedAt

  @@schema("system")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  text      String
  link      String?
  important Boolean   @default(false) // stays until read
  event     String? // its type (NOTIFICATION_EVENTS key), for the bell's filter (M-14 5.1 · 5.3)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  mails     MailLog[]

  // a database trigger announces every new row (pg_notify 'notification_created'): the bell updates at once (12.11)
  @@index([userId, readAt])
  @@index([userId, event])
  @@schema("system")
}

model NotificationRule {
  event    String   @id // see NOTIFICATION_EVENTS in @places/domain
  toRoles  String[]
  channels String[] // app · push · email

  @@schema("system")
}

/// M-14 (51): a browser or phone that turned push notifications on from «حسابي» (Web Push, VAPID). One row per device.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique // the browser's push service address for this device
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@schema("system")
}

/// M-14 2.3 · 2.4 · 3.3: every email the system sends. The worker sends the queued ones (within a minute), and it is
/// the send log: «اتبعت» · «اتقرا» (its in-app copy was read) · «الإيميل فشل».
model MailLog {
  id             String        @id @default(cuid())
  to             String
  subject        String
  text           String
  attachments    Json? // [{ filename, base64 }]: the quarterly PDF and the like, kept until the worker sends them
  status         String        @default("queued") // queued · sent · failed
  attempts       Int           @default(0)
  error          String?
  notificationId String? // the in-app copy of the same notification: its readAt is «اتقرا»
  notification   Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  nextAttemptAt  DateTime      @default(now())
  createdAt      DateTime      @default(now())
  sentAt         DateTime?

  @@index([status, nextAttemptAt])
  @@index([createdAt])
  @@schema("system")
}

/// Every create / update / delete / money change: who, when, what, before → after (Q50).
enum FileStatus {
  PENDING  // link handed out, the browser hasn't finished uploading
  READY    // uploaded and checked (size and type match what was asked)
  REJECTED // the uploaded object didn't match: deleted from storage

  @@schema("system")
}

/// Every stored object (photos, PDFs, receipts, sheets). The bytes live in S3/MinIO under `key`; this is the record.
model File {
  id           String     @id @default(cuid())
  key          String     @unique // <yyyy>/<mm>/<id>.<ext> in the bucket: never built from the uploaded name
  name         String     // the original file name, shown on download
  mime         String
  size         Int        // bytes, as declared before upload and checked after
  status       FileStatus @default(PENDING)
  uploadedById String
  entity       String?    // what it belongs to, e.g. "Unit" + its id; set by the module that uses it
  entityId     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([entity, entityId])
  @@index([status, createdAt]) // #209: the nightly sweep of PENDING uploads
  @@index([uploadedById])
  @@schema("system")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  at        DateTime @default(now())
  userId    String?
  module    String
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  ip        String?
  userAgent String? // the device (M-09 2.1 step 5)

  @@index([module, at])
  @@index([userId, at])
  @@index([entity, entityId])
  @@schema("system")
}

/// M-05 7.12 · a name in a fingerprint sheet that matched nobody: waits for HR to link it.
model FingerprintUnmatched {
  id           String   @id @default(cuid())
  name         String
  day          DateTime @db.Date
  checkIn      String?  // HH:MM, Cairo
  checkOut     String?
  uploadedById String
  createdAt    DateTime @default(now())

  @@unique([name, day])
  @@schema("hr")
}

/// A sheet / device name HR linked to an employee once; the next sheets match it by itself.
model FingerprintAlias {
  name       String   @id // normalised (normName)
  employeeId String
  createdAt  DateTime @default(now())

  @@schema("hr")
}

/// M-05 7.4 · an Excuse: a ticket to the Team Leader, then HR; its number in the month decides what it costs.
model ExcuseRequest {
  id          String    @id @default(cuid())
  employeeId  String
  day         DateTime  @db.Date
  reason      String
  number      Int       // its number in the month (1, 2, 3 …)
  status      String    @default("pending_tl") // pending_tl · approved_tl · confirmed · rejected · refused
  ticketId    String?   @unique
  tlUserId    String?
  hrUserId    String?
  rejectReason String?
  createdById String
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?

  @@index([employeeId, day])
  @@schema("hr")
}

/// M-08 3.1 · the office assets register Mokhtar keeps (KPI M-12: updated and reviewed every month).
model OfficeAsset {
  id          String    @id @default(cuid())
  name        String
  place       String    @default("")
  needsRepair Boolean   @default(false) // «محتاج صيانة»; false = «سليم»
  archivedAt  DateTime? // taken off the register (sold, thrown away): kept for the audit trail
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([archivedAt])
  @@schema("ops")
}

/// Every «اتراجع الشهر ده» on the register: who reviewed it and when (the KPI reads the latest).
model OfficeAssetReview {
  id           String   @id @default(cuid())
  reviewedById String
  at           DateTime @default(now())

  @@index([at])
  @@schema("ops")
}

/// M-08 3.1 · the office boys' rota by area (KPI M-12: ≥90% compliance, rated by Nancy on Mokhtar's card).
model OfficeBoyShift {
  id        String   @id @default(cuid())
  area      String   // «الدور الأرضي + الاستقبال»
  name      String   // the office boy: not a system user
  slots     String   // «9:00 · 13:00 · 17:00» or «قبل كل اجتماع»
  createdAt DateTime @default(now())

  @@schema("ops")
}

/// M-07 · one treasury voucher (9.2, 9.3, 9.11): pay · receive · transfer · advance · custody · settle, with its journal entry.
model TreasuryMove {
  id          String   @id @default(cuid())
  no          Int      @unique @default(autoincrement())
  kind        String
  date        DateTime
  fromId      String?
  from        Account? @relation("MoveFrom", fields: [fromId], references: [id])
  toId        String?
  to          Account? @relation("MoveTo", fields: [toId], references: [id])
  /// the expense / revenue / the person's 131 or 134 account
  accountId   String?
  account     Account? @relation("MoveAccount", fields: [accountId], references: [id])
  /// settle: the expense the custody was spent on
  expenseId   String?
  amount      Decimal  @db.Decimal(14, 2)
  spent       Decimal? @db.Decimal(14, 2)
  returned    Decimal? @db.Decimal(14, 2)
  party       String   // who received / paid (an employee's name, a vendor, a company)
  partyId     String?  // the employee (user id) for advances and custody
  ref         String?
  memo        String
  entryId     String   @unique
  createdById String
  createdAt   DateTime @default(now())
  purchase    Purchase?
  claim       Claim?

  @@index([fromId])
  @@index([toId])
  @@index([date])
  @@schema("finance")
}

/// M-07 · a month closed by hand (9.8): «اقفل الشهر» / «اقفل الربع». Months before today's close by themselves.
model FinancePeriod {
  month       String   @id // 2026-11
  status      String   // month · quarter
  closedById  String
  closedAt    DateTime @default(now())

  @@schema("finance")
}

/// M-07 · a fixed bill (9.16): never pays by itself — on its day the accountant approves and pays, or skips the month.
model RecurringBill {
  id           String   @id @default(cuid())
  name         String
  vendor       String
  accountId    String   // the expense line (5…)
  fromId       String   // the usual safe / bank
  amount       Decimal  @db.Decimal(14, 2) // the usual amount (the voucher can differ)
  day          Int      // 1–28
  active       Boolean  @default(true)
  /// the month its «ميعاد فاتورة» notification went out (the job runs daily; once a month)
  notifiedFor  String?
  createdById  String
  createdAt    DateTime @default(now())
  months       RecurringBillMonth[]

  @@schema("finance")
}

model RecurringBillMonth {
  id        String        @id @default(cuid())
  billId    String
  bill      RecurringBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  month     String        // 2026-11
  status    String        // paid · skipped
  moveId    String?       // the payment voucher
  reason    String?       // why not this month
  byId      String
  at        DateTime      @default(now())

  @@unique([billId, month])
  @@schema("finance")
}

/// M-07 · one month's payroll (9.14): paid once, as one voucher «صرف مرتبات» with one entry.
model PayrollRun {
  id          String        @id @default(cuid())
  month       String        @unique // 2026-11
  moveId      String        @unique
  fromId      String
  gross       Decimal       @db.Decimal(14, 2)
  net         Decimal       @db.Decimal(14, 2)
  createdById String
  at          DateTime      @default(now())
  lines       PayrollLine[]

  @@schema("finance")
}

model PayrollLine {
  id         String     @id @default(cuid())
  runId      String
  run        PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId     String
  name       String
  line       String     // admin · sales
  salary     Decimal    @db.Decimal(14, 2)
  attendance Decimal    @db.Decimal(14, 2)
  advance    Decimal    @db.Decimal(14, 2)
  net        Decimal    @db.Decimal(14, 2)

  @@index([runId])
  @@index([userId])
  @@schema("finance")
}

/// «يتخصم كام الشهر ده» from a person's advance (9.3 / 9.14); the next month starts with the same choice.
model AdvanceDeduction {
  id       String   @id @default(cuid())
  userId   String
  month    String
  amount   Decimal  @db.Decimal(14, 2)
  byId     String
  at       DateTime @default(now())

  @@unique([userId, month])
  @@schema("finance")
}

/// 12.12 · who claims and receipts go out under (Places · ذراين للدعاية والإعلان): the logo and the bank details printed on a claim.
model Entity {
  id          String   @id // places · zrain
  name        String
  logoFileId  String? // a system.File (0.9)
  bank        String   @default("")
  accountName String   @default("")
  accountNo   String   @default("")
  iban        String   @default("")
  claims      Claim[]
  updatedAt   DateTime @updatedAt

  @@schema("system")
}

/// 12.12 · the admin's wording for a document; no row = the default in @places/domain (DOC_DEFAULTS).
model DocTemplate {
  kind      String   @id // claim · receipt
  title     String
  body      String
  closing   String
  updatedAt DateTime @updatedAt

  @@schema("system")
}

/// M-07 9.17 · a claim to a company → the e-invoice → the cash receipt (from the templates, with the stamp).
model Claim {
  id             String        @id @default(cuid())
  no             Int           @unique @default(autoincrement()) // CL-<no>
  dealId         String? // the deal it comes from: deals (5.1/5.2) aren't built yet, so it stays empty for now
  company        String // as it is written on the claim
  unit           String
  unitInfo       String
  amount         Decimal       @db.Decimal(14, 2)
  side           String // client · owner
  kind           String // نوع العمولة, e.g. «عمولة تأجير»
  entityId       String
  entity         Entity        @relation(fields: [entityId], references: [id])
  note           String?
  status         String        @default("requested")
  why            String? // the rejection's reason
  requestedById  String
  issuedById     String?
  issuedAt       DateTime?
  approvedAt     DateTime? // the client approved it
  receiptAskedAt DateTime? // sales: the client paid, make the receipt
  einvoiceNo     String?
  einvoiceDate   DateTime?     @db.Date
  moveId         String?       @unique // the receive voucher (9.11)
  move           TreasuryMove? @relation(fields: [moveId], references: [id])
  receiptNo      Int?          @unique // RC-<n>, serial
  payMethod      String?
  paidAt         DateTime?     @db.Date
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([requestedById])
  @@schema("finance")
}

/// The quarters the KPI cards run in (11.1 · 11.11). The latest one is the current quarter; a new one starts from a copy
/// of the last one's cards (same items and weights, nothing achieved) and the old cards keep their final results.
model KpiQuarter {
  id         String    @id // "2026-Q4"
  status     String    @default("open") // open · closed
  startedAt  DateTime  @default(now())
  closedAt   DateTime?
  closedById String?
  /// 11.7: the Office Manager approved the quarterly sheets (PDF) and they were emailed
  sheetsAt   DateTime?
  sheetsById String?

  @@schema("kpi")
}

/// 11.13 · a Farming / Approach a salesperson plans (where, when); after its time he says whether he did it and what
/// came of it (Farming: brought something new + a note · Approach: the companies). The Farming item counts the done
/// ones on the day they happened (`at`).
model SalesActivity {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  kind       String    // Farming · Approach
  place      String
  at         DateTime
  status     String    @default("planned") // planned · done · notDone
  got        Boolean?
  note       String?
  companies  String[]  @default([])
  doneAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([employeeId, at])
  @@schema("kpi")
}

/// A hand-in on a report item (11.2): a link or an uploaded file, and when.
model KpiDelivery {
  id     String   @id @default(cuid())
  itemId String
  item   KpiItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  at     DateTime @default(now())
  byId   String
  link   String?
  fileId String?

  @@schema("kpi")
}

/// 11.10 · a scheduled report (meeting 4 Nov): the system sends it (auto, `content` = what it builds) or people hand it in
/// (handin: `preparedBy`, a reminder `remindMin` before, `lateNotify` told after). Names are user ids, role keys or
/// "follower". `money` keeps it from the KPI watcher. `daily` = the daily report of every team (11.12).
/// A KpiItem whose `report` is this id counts the on-time hand-ins.
model ScheduledReport {
  id         String         @id @default(cuid())
  name       String
  on         Boolean        @default(true)
  kind       String // auto · handin
  freq       String // daily · weekly · monthly · quarterly
  day        Int            @default(0) // weekday 0–6 (Sunday = 0) or day of the month
  time       String // "HH:MM" Cairo
  fmt        String         @default("جوه السيستم")
  content    String? // auto: "performance" (11.10 the sales performance report)
  preparedBy String[]       @default([])
  recipients String[]       @default([])
  remindMin  Int            @default(60)
  lateNotify String[]       @default([])
  money      Boolean        @default(false)
  daily      Boolean        @default(false)
  createdAt  DateTime       @default(now()) // first run: periods due before this aren't sent or chased
  handIns    ReportHandIn[]
  runs       ReportRun[]

  @@schema("kpi")
}

/// One person's hand-in for one period (its due date): when, and the reminder / late notice the worker sent once.
model ReportHandIn {
  id         String          @id @default(cuid())
  reportId   String
  report     ScheduledReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId     String
  period     String // "YYYY-MM-DD", the due date
  at         DateTime?
  remindedAt DateTime?
  lateAt     DateTime?

  @@unique([reportId, userId, period])
  @@schema("kpi")
}

/// An auto report the system built: its rows, listed under the report and downloadable as Excel.
model ReportRun {
  id       String          @id @default(cuid())
  reportId String
  report   ScheduledReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  period   String
  at       DateTime        @default(now())
  title    String
  rows     Json

  @@unique([reportId, period])
  @@schema("kpi")
}

/// 11.12 · one person's daily report: what he typed (KpiItem key or extra field id → value) and when he handed it in.
model DailyReport {
  id     String   @id @default(cuid())
  userId String
  day    DateTime @db.Date
  values Json     @default("{}")
  note   String   @default("")
  at     DateTime @default(now())

  @@unique([userId, day])
  @@schema("kpi")
}

/// 11.12 · an extra field on one person's daily report (a number or a sentence), added by the admin / the KPI watcher.
model DailyReportField {
  id       String @id @default(cuid())
  userId   String
  label    String
  type     String // number · text
  position Int    @default(0)

  @@index([userId])
  @@schema("kpi")
}

/// 11.8 · a salesperson's target for a month: value (his share of collections), Transactions and visits. A change in the
/// middle of the month waits in `pending` until someone with «reports: approve» accepts it.
model SalesTarget {
  id         String  @id @default(cuid())
  employeeId String
  month      String // "YYYY-MM"
  value      Decimal @db.Decimal(14, 2)
  deals      Int     @default(0)
  visits     Int     @default(0)
  pending    Json? // { value, deals, visits, by }

  @@unique([employeeId, month])
  @@schema("kpi")
}
