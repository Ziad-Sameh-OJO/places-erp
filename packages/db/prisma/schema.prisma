// Places ERP — database schema. One PostgreSQL database, one schema per business area (comments mark the M-xx module).
// Conventions: ids are cuid strings · money is Decimal(14,2) EGP (the domain package works in integer piasters) ·
// every table has createdAt/updatedAt · nothing business-relevant is hard-deleted (archivedAt) · times are UTC.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["access", "sales", "inventory", "marketing", "hr", "ops", "finance", "kpi", "system"]
}

// ───────────────────────────── M-09 · users, roles, permissions ─────────────────────────────

enum AccountStatus {
  INVITED
  ACTIVE
  LOCKED
  DISABLED

  @@schema("access")
}

enum DataScope {
  OWN
  TEAM
  DEPT
  ALL

  @@schema("access")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  phone         String?
  passwordHash  String?       // argon2id; null until the invite is accepted
  status        AccountStatus @default(INVITED)
  failedLogins  Int           @default(0)
  otpRequired   Boolean       @default(false) // client decision 28/10: off for everyone, admin can turn it on per person
  emailNotifications Boolean  @default(true)  // M-14 «my preferences»: important ones always reach the bell anyway
  tokens        AuthToken[]
  lastLoginAt   DateTime?
  endDate       DateTime?     // last working day: the account stops by itself
  employee      Employee?
  roles         UserRole[]
  overrides     PermissionOverride[]
  sessions      Session[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@schema("access")
}

model Session {
  id        String   @id // random 256-bit token hash
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@schema("access")
}

/// One-time secrets sent by email: account activation, password reset, sign-in OTP. Only the hash is stored.
model AuthToken {
  id        String        @id // sha256 of the token / of userId+code for OTP
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      AuthTokenKind
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, kind])
  @@schema("access")
}

enum AuthTokenKind {
  INVITE
  RESET
  OTP

  @@schema("access")
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique // admin, officemgr, sales, tl, … or a custom role
  label       String
  tier        String           // Super Admin · Office Manager · Department Head · Executive Staff …
  behavesLike String?          // a custom role reuses a built-in role's home page and inboxes
  builtIn     Boolean          @default(false) // the 18 roles from the requirements: can't be deleted
  scope       DataScope        @default(OWN)
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@schema("access")
}

model RolePermission {
  roleId  String
  role    Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module  String   // see MODULES in @places/domain
  actions String[] // view · create · edit · approve · delete · import · export

  @@id([roleId, module])
  @@schema("access")
}

model UserRole {
  userId  String
  roleId  String
  primary Boolean @default(false)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@schema("access")
}

/// A per-person exception that replaces the person's roles for one module.
model PermissionOverride {
  userId  String
  module  String
  actions String[]
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, module])
  @@schema("access")
}

// ───────────────────────────── M-05 · employees, attendance, leave ─────────────────────────────

model Employee {
  id              String          @id @default(cuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id])
  name            String
  jobTitle        String
  department      String
  managerId       String?         // who follows this person (KPIs, approvals)
  manager         Employee?       @relation("Follows", fields: [managerId], references: [id])
  reports         Employee[]      @relation("Follows")
  teamLeaderId    String?         // sales teams A–D
  teamLeader      Employee?       @relation("SalesTeam", fields: [teamLeaderId], references: [id])
  teamMembers     Employee[]      @relation("SalesTeam")
  team            String?         // "A" · "B" · "C" · "D"
  salary          Decimal         @db.Decimal(14, 2)
  target          Decimal         @default(0) @db.Decimal(14, 2)
  commissionPct   Decimal         @default(0) @db.Decimal(5, 2) // the scheme, e.g. 30
  partTime        Boolean         @default(false)
  partTimeDeductions Boolean      @default(false) // M-05 3.1: HR decides if a part-timer has deductions
  joinedAt        DateTime?
  deductionTiers  Json?           // per-person tiers (Q33); null = company default
  fixedSchedule   String?         // e.g. CFO: Mon & Thu 17:00–19:00
  leaveBalance    Int             @default(21)
  attendance      AttendanceDay[]
  leaves          LeaveRequest[]
  penalties       Penalty[]
  oneOnOnes       OneOnOne[]
  dealParts       DealParticipant[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  kpiCards        KpiCard[]       @relation("KpiOwner")
  kpiFollowing    KpiCard[]       @relation("KpiFollower")
  salesActivities SalesActivity[]
  @@schema("hr")
}

enum AttendanceKind {
  CHECKIN
  EXCUSE
  VISIT
  OUTSIDE_APPROVED
  FORGOT
  ABSENT
  SPECIAL_SCHEDULE

  @@schema("hr")
}

model AttendanceDay {
  id               String         @id @default(cuid())
  employeeId       String
  employee         Employee       @relation(fields: [employeeId], references: [id])
  day              DateTime       @db.Date
  checkInAt        DateTime?
  checkOutAt       DateTime?
  visitAt          DateTime?      // 7.3: the Visit that started a salesperson's day; HR sees it next to the real fingerprint
  kind             AttendanceKind @default(CHECKIN)
  deduction        Decimal        @default(0) @db.Decimal(3, 2) // 0 · 0.25 · 0.5 · 1
  lateMinutes      Int            @default(0)
  hrConfirmed      Boolean        @default(false)
  source           String         // device · sheet · system
  createdAt        DateTime       @default(now())

  @@unique([employeeId, day]) // the same sheet uploaded twice never duplicates a day
  @@schema("hr")
}

enum LeaveStatus {
  PENDING_TL
  APPROVED_BY_TL
  REJECTED
  CLOSED_BY_HR

  @@schema("hr")
}

model LeaveRequest {
  id           String      @id @default(cuid())
  employeeId   String
  employee     Employee    @relation(fields: [employeeId], references: [id])
  type         String
  fromDay      DateTime    @db.Date
  toDay        DateTime    @db.Date
  reason       String?
  status       LeaveStatus @default(PENDING_TL)
  rejectReason String?
  /// M-05 7.5: days counted, the document (sick / emergency), who decides at each step, the 24 / 48-hour chase
  days         Int         @default(0)
  documentId   String?
  tlUserId     String?     // the Team Leader (or manager) who decides first; null = straight to HR
  tlDecidedAt  DateTime?
  hrUserId     String?
  closedAt     DateTime?
  remindedAt   DateTime?
  escalatedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([employeeId, createdAt]) // 13.3: an employee's leaves, newest first
  @@index([status])
  @@schema("hr")
}

model Penalty {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  day        DateTime @db.Date
  text       String
  byUserId   String
  /// M-05 7.7: the deduction in days, and HR's approval (a TL's proposal waits for it)
  deductionDays Decimal @default(0) @db.Decimal(4, 2)
  status     String   @default("approved") // pending · approved · rejected
  approvedById String?
  decidedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([day])
  @@schema("hr")
}

/// M-05 (32) · 7.9: HR approves the month's deductions once; payroll (9.14) reads these numbers, not the live ones.
model DeductionApproval {
  id           String   @id @default(cuid())
  month        String   @unique // 2026-11
  lines        Json     // [{ userId, employeeId, attendanceDays, penaltyDays, amount }] · amount as a decimal string
  approvedById String
  at           DateTime @default(now())

  @@schema("hr")
}

model OneOnOne {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  heldOn      DateTime  @db.Date
  answers     Json
  hrAction    String?
  hrActionDue DateTime? @db.Date
  hrActionDone Boolean  @default(false)
  /// M-05 7.8: who held it, and when «حل الـ HR» rang (once)
  byUserId    String?
  alarmedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([employeeId, heldOn]) // 13.3: an employee's 1:1 history
  @@schema("hr")
}

// ───────────────────────────── M-01 · leads & companies ─────────────────────────────

/// A lead is a client or a broker (client meeting 4 Nov · 1.28).
enum LeadKind {
  CLIENT
  BROKER

  @@schema("sales")
}

enum LeadStage {
  FRESH
  INTERESTED
  NOT_INTERESTED
  NO_ANSWER
  FOLLOW_UP_TO_VISIT
  VISIT
  FOLLOW_UP_AFTER_VISIT
  FOLLOW_UP_TO_MEETING
  MEETING
  FOLLOW_UP_AFTER_MEETING
  NEAR_TO_CLOSE
  DONE_DEAL
  CANCELLATION
  HOLD

  @@schema("sales")
}

model Lead {
  id             String        @id @default(cuid())
  code           String        @unique // L-1001…
  name           String
  companyId      String?
  company        Company?      @relation(fields: [companyId], references: [id])
  phones         String[]
  area           String
  type           String        // Rent · Resale · Primary · Income
  space          Int?
  condition      String?
  budget         Decimal?      @db.Decimal(14, 2)
  channel        String
  campaignId     String?
  campaign       Campaign?     @relation(fields: [campaignId], references: [id])
  stage          LeadStage     @default(FRESH)
  kind           LeadKind      @default(CLIENT) // client meeting 4 Nov (1.28): brokers have their own tab, same stages
  selfEntered    Boolean       @default(false)  // the salesperson entered it himself (KPI 11.15)
  qualified      Boolean       @default(false) // sticky, see isQualifiedAfter
  assignedToId   String?
  assignedAt     DateTime?
  touched        Boolean       @default(false)
  ownedByTelesales Boolean     @default(false)
  noAnswerCount  Int           @default(0)
  rotation       Int           @default(1)  // how many salespeople it went through on No Answer; the 3rd goes to Telesales (M-01 3.2)
  arrivedAt      DateTime      @default(now()) // KPI: first call within 30 min · the campaign WhatsApp message time if it came that way
  firstCallAt    DateTime?     // KPI: the first call within 30 minutes of arrivedAt (domain firstCallOnTime)
  firstActionAt  DateTime?     // the salesperson's first action (comment, call, stage change…): stops the SLA clock (M-01 «من غير أي أكشن»)
  slaWarnedAt    DateTime?     // the TL got the 2h30 warning for this assignment (cleared on reassign)
  note           String?
  post           String?       // the campaign post it came from (M-04: channel → campaign → post)
  answers        Json?         // answers to the recommendation questions, they narrow the suggested units
  verification   Json?         // Second Call: { called, sent, byUserId, at }
  activities     LeadActivity[]
  arrivals       LeadArrival[]
  calls          LeadCall[]
  duplicates     LeadDuplicate[]
  visits         LeadVisit[]
  suggestedUnits LeadUnit[]
  deals          Deal[]
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  archivedAt     DateTime?

  @@index([assignedToId, stage])
  @@index([kind])
  @@index([area])
  @@index([createdAt])
  @@index([phones], type: Gin) // the duplicate check on every new lead
  @@schema("sales")
}

/// Visits and meetings (M-01 3.3 «Visit»): the time, the units shown, an alarm at the time, then Done / not done.
model LeadVisit {
  id        String      @id @default(cuid())
  leadId    String
  lead      Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind      String      @default("visit") // visit · meeting
  at        DateTime
  extra     String?     // spaces that aren't in the inventory sheet yet («دور 4 في مبنى B6»)
  outcome   String?     // done · not_done (not done shows for HR in attendance, M-07); null = still planned
  alarmedAt DateTime?   // the salesperson got the Alarm at its time (the worker sends it once; editing the time sends it again)
  // 1.24 «اتأجلت»: pending · approved · rejected; approved = that day without a deduction (7.3)
  postponeStatus      String?
  postponeReason      String?
  postponeRequestedBy String?
  postponeDecidedBy   String?
  postponeDecidedAt   DateTime?
  units     VisitUnit[]
  byUserId  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([leadId, at])
  @@index([at]) // the alarm job: visits due now and not marked
  @@schema("sales")
}

model VisitUnit {
  visitId String
  visit   LeadVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  unitId  String
  unit    Unit      @relation(fields: [unitId], references: [id])

  @@id([visitId, unitId])
  @@schema("sales")
}

/// Units the salesperson picked for this client from the inventory (with the recommendations, M-01 3.2).
model LeadUnit {
  leadId   String
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  unitId   String
  unit     Unit     @relation(fields: [unitId], references: [id])
  byUserId String
  at       DateTime @default(now())

  @@id([leadId, unitId])
  @@index([unitId])
  @@schema("sales")
}

/// Every time a lead reaches us — the first time and every duplicate — counted for its channel / campaign
/// (M-04 Q22: «الليد المكرر بيتحسب كل مرة»). The lead's own channel is the one that gets the credit.
model LeadArrival {
  id         String         @id @default(cuid())
  leadId     String
  lead       Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel    String
  campaignId String?
  campaign   Campaign?      @relation(fields: [campaignId], references: [id])
  duplicate  Boolean        @default(false)
  byUserId   String?        // null = imported / the system
  at         DateTime       @default(now())
  review     LeadDuplicate?

  @@index([leadId])
  @@index([campaignId, at])
  @@index([channel, at])
  @@schema("sales")
}

/// A lead entered again with a mobile we already have. Operations compares both and chooses what stays and which
/// channel gets the credit (M-01 Q7). `data` is what was entered; `decision` what Operations chose.
model LeadDuplicate {
  id          String      @id @default(cuid())
  leadId      String
  lead        Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  arrivalId   String      @unique
  arrival     LeadArrival @relation(fields: [arrivalId], references: [id], onDelete: Cascade)
  data        Json
  byUserId    String
  at          DateTime    @default(now())
  decidedAt   DateTime?
  decidedById String?
  decision    Json?

  @@index([decidedAt])
  @@schema("sales")
}

/// Every call a salesperson or Telesales logs on a lead (M-01 3.1): the KPIs count them (Telesales 100 a day,
/// sales 50 a week) and the first one is measured against the lead's arrival (30 minutes).
model LeadCall {
  id       String   @id @default(cuid())
  leadId   String
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  byUserId String
  at       DateTime @default(now())

  @@index([byUserId, at])
  @@index([leadId, at])
  @@schema("sales")
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind      String   // call · stage · comment · visit · meeting · whatsapp
  text      String
  byUserId  String?  // null = the system
  at        DateTime @default(now())

  @@index([leadId, at])
  @@schema("sales")
}

model Company {
  id                 String   @id @default(cuid())
  name               String
  category           String   // 63 categories (M-13 list)
  number             String?
  contactName        String?
  contactTitle       String?
  email              String?
  currentLocation    String?
  currentSpace       Int?
  contractStart      DateTime? @db.Date
  contractEnd        DateTime? @db.Date
  averageRent        Decimal?  @db.Decimal(14, 2)
  annualEscalation   Decimal?  @db.Decimal(5, 2)
  feedback           String?
  outbound           Boolean   @default(false) // added by Telesales herself (KPI)
  leads              Lead[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([name, number])
  @@schema("sales")
}

// ───────────────────────────── M-02 · deals, collections, TCR ─────────────────────────────

enum DealStatus {
  PENDING_REVIEW
  APPROVED
  PARTIALLY_COLLECTED
  FULLY_COLLECTED
  REJECTED
  CANCELLED

  @@schema("sales")
}

/// M-02 3.1 «type»: the four kinds of deal on the done-deals sheet.
enum DealType {
  Rent
  Resale
  Primary
  Income

  @@schema("sales")
}

model Deal {
  id               String            @id @default(cuid())
  code             String            @unique // D-301…
  leadId           String?
  lead             Lead?             @relation(fields: [leadId], references: [id])
  unitId           String
  unit             Unit              @relation(fields: [unitId], references: [id])
  type             DealType
  space            Int
  location         String
  company          String            // M-02 3.1 «company»: the client's company when the deal was registered (the lead's name if none)
  source           String            // M-02 3.1 «source»: the lead's channel
  status           DealStatus        @default(PENDING_REVIEW)
  commissionOwner  Decimal           @db.Decimal(14, 2)
  commissionClient Decimal           @db.Decimal(14, 2)
  targetBase       Decimal?          @db.Decimal(14, 2) // «note» override, target only
  note             String?
  offTarget        Boolean           @default(false)    // created and closed within a day (Q13)
  closedAt         DateTime
  execDueAt        DateTime?         @db.Date
  executedAt       DateTime?         @db.Date
  papersOk         Boolean?          // Finance's check of contract · mandate · registration
  papersNote       String?
  reviewedById     String?           // the Office Manager who approved or rejected it (Q9)
  reviewedAt       DateTime?
  reviewNote       String?           // why it went back to the salesperson (Q9)
  cancelledAt      DateTime?         // Q12: a cancelled deal drops out of revenue, targets and commissions
  cancelNote       String?
  participants     DealParticipant[]
  payments         Payment[]
  tcrs             Tcr[]
  createdById      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status])
  @@index([leadId])
  @@index([unitId])
  @@schema("sales")
}

enum DealSide {
  BUYER
  SELLER

  @@schema("sales")
}

model DealParticipant {
  dealId     String
  employeeId String
  side       DealSide
  approved   Boolean  @default(true) // the Seller waits for Manar's approval
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@id([dealId, employeeId])
  @@index([employeeId])
  @@schema("sales")
}

model Payment {
  id          String   @id @default(cuid())
  dealId      String
  deal        Deal     @relation(fields: [dealId], references: [id])
  side        String   // owner · client
  amount      Decimal  @db.Decimal(14, 2)
  receivedAt  DateTime // the day it showed in the account (KPI: commission the same day)
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  recordedById String
  tcr         Tcr?
  createdAt   DateTime @default(now())

  @@schema("sales")
}

model Tcr {
  id         String         @id @default(cuid())
  code       Int            @unique // T180, T181 … one sequence for the company
  dealId     String
  deal       Deal           @relation(fields: [dealId], references: [id])
  paymentId  String         @unique
  payment    Payment        @relation(fields: [paymentId], references: [id])
  signatures TcrSignature[]
  pdfKey     String?        // file in object storage
  createdAt  DateTime       @default(now())

  @@schema("sales")
}

model TcrSignature {
  tcrId      String
  employeeId String
  signedAt   DateTime?
  tcr        Tcr       @relation(fields: [tcrId], references: [id], onDelete: Cascade)

  @@id([tcrId, employeeId])
  @@schema("sales")
}

// ───────────────────────────── M-03 · inventory & Not Active ─────────────────────────────

/// M-03 3.1: the unit's sheet. Rent · Resale · Income each have their own columns (sources/inventory-unit-fields.md).
/// Primary is in the client's KPIs (Randa enters «Resale / Primary» units) but its own columns weren't sent yet,
/// so it has the common ones only (needs-client).
enum UnitType {
  Rent
  Resale
  Income
  Primary

  @@schema("inventory")
}

/// rented / sold units move to the «rented» sheet (M-03 1.3, 5.2)
enum UnitStatus {
  available
  rented
  sold

  @@schema("inventory")
}

model Unit {
  id                String      @id @default(cuid())
  code              String      @unique // U-101… from inventory.unit_code_seq (M-03 3.2: serial codes)
  type              UnitType
  alsoType          UnitType?   // available as a second type at the same time (M-03 Q17)
  status            UnitStatus  @default(available)
  alsoStatus        UnitStatus? // closing one side leaves the other open (Q17)
  project           String      // Rent «project» · Resale / Income «اسم المبنى»
  area              String
  space             Int         // gross area, m²
  condition         String      // Rent «conditions» · Resale «التشطيب»
  floor             String?
  building          String?     // «build num» / «رقم المبنى» (number and text)
  parking           Int         @default(0)
  ownerName         String?     // Rent «contact» · Resale «اسم الأونر» · Income «الاسم»
  ownerPhone        String?     // «number»: the owner's number (Not Active sheets are compared by it, M-03 1.1)
  pricePerSqm       Decimal?    @db.Decimal(14, 2) // Rent: rent per m² · Resale / Income: sale price per m²
  totalPrice        Decimal?    @db.Decimal(14, 2) // pricePerSqm × space, written by the domain on every save (filters by price)
  leasePerSqm       Decimal?    @db.Decimal(14, 2) // Income: lease price per m²
  maintenance       String?     // number and text
  commission        String?     // number and text
  paymentMethod     String?     // Resale / Income
  details           Json        @default("{}") // the columns only one type has (Resale delivery, Income contract…), checked by @places/contracts
  agentId           String?     // hr.Employee: who brought the unit → Seller on a deal (M-02), counted in their activity
  divisible         Boolean     @default(false)
  minSplit          Int?        // the smallest part it can be split into (M-03 3.1)
  splitNote         String?     // what the split is (Q20: Manar writes it)
  areaTabId         String?     // the area tab Manar picked (M-03 3.2); null = by its area
  areaTab           AreaTab?    @relation(fields: [areaTabId], references: [id], onDelete: SetNull)
  location          String?     // "lat, lng" picked on the map
  pdfStatus         String      @default("draft") // draft · confirmed (Manar, Q15/Q19)
  receivedAt        DateTime?   // KPI: entered within 24h of receiving it
  enteredAt         DateTime    @default(now())
  mediaUrl          String?
  mediaUploadedAt   DateTime?
  lastOwnerUpdateAt DateTime    @default(now()) // «last update»: older than a month = late (M-03 2.4)
  createdById       String?     // the user who entered it (Manar / Randa activity)
  deals             Deal[]
  suggestedFor      LeadUnit[]
  shownInVisits     VisitUnit[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  archivedAt        DateTime?

  @@index([type, status])
  @@index([area])
  @@index([space])
  @@index([totalPrice])
  @@index([ownerPhone])
  @@index([areaTabId])
  @@schema("inventory")
}

/// M-03 7.2 · the area tabs under the list (101 to 200 …): the inventory team adds, edits and removes them (12.8).
model AreaTab {
  id        String   @id @default(cuid())
  min       Int
  max       Int?     // null = and above («+800»)
  units     Unit[]
  createdAt DateTime @default(now())

  @@schema("inventory")
}

model NotActiveSheet {
  id        String         @id @default(cuid())
  name      String         @unique // e.g. CFC
  dedupeBy  String         // column used to merge without duplicates
  rows      NotActiveRow[]
  createdAt DateTime       @default(now())

  @@schema("inventory")
}

model NotActiveRow {
  id         String         @id @default(cuid())
  sheetId    String
  sheet      NotActiveSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  data       Json
  dedupeKey  String
  status     String?        // No Answer · Not True · Done
  feedback   String?        // required for Not True
  assignedTo String?
  unitId     String?        // the unit created when Done

  @@unique([sheetId, dedupeKey])
  @@schema("inventory")
}

model ListRequest {
  id           String    @id @default(cuid())
  requestedBy  String    // Team Leader
  text         String
  unitCodes    String[]
  unconfirmed  Int       @default(0)
  doneById     String?
  doneAt       DateTime?
  createdAt    DateTime  @default(now())

  @@schema("inventory")
}

// ───────────────────────────── M-04 · marketing & tasks ─────────────────────────────

model Campaign {
  id        String   @id @default(cuid())
  name      String
  channel   String
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  budget    Decimal  @db.Decimal(14, 2)
  spent     Decimal  @default(0) @db.Decimal(14, 2)
  target    String?
  adUrl     String?
  leads     Lead[]
  arrivals  LeadArrival[]
  createdAt DateTime @default(now())

  @@schema("marketing")
}

model Task {
  id        String    @id @default(cuid())
  kind      String    // photo · retouch · followup · toResale · marketing · team
  title     String?
  unitId    String?
  byUserId  String
  toUserId  String
  dueOn     DateTime  @db.Date
  status    String    @default("todo") // todo · progress · uploaded · done
  returned  Int       @default(0)      // sent back for changes (KPI: accepted first time)
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([toUserId, status])
  @@schema("marketing")
}

// ───────────────────────────── M-06 · tickets ─────────────────────────────

model Ticket {
  id           String        @id @default(cuid())
  number       Int           @unique @default(autoincrement()) // shown as TK-<number>
  type         String        // a key of TICKET_TYPES in @places/domain: request · hr_letter · dispute · list · purchase
  department   String        // a value of «أقسام التذاكر» (M-13); a transfer changes it, the events keep the history
  title        String
  priority     String        @default("normal") // normal · high
  status       String        @default("Open")   // Open · In Progress · Resolved · Closed
  fromUserId   String
  firstReplyAt DateTime?     // the department's first reply (M-06 3.2: response time)
  resolvedAt   DateTime?     // settled (Resolved, or Closed straight away): «اتقفلت في الـ SLA»
  closedAt     DateTime?
  escalatedAt  DateTime?     // M-06 2.4: the late ticket was escalated (once)
  events       TicketEvent[]
  createdAt    DateTime      @default(now())

  @@index([department, status])
  @@index([fromUserId])
  @@index([createdAt])
  @@schema("ops")
}

model TicketEvent {
  id       String   @id @default(cuid())
  ticketId String
  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  kind     String   // open · reply · status · transfer · close · escalate
  text     String
  byUserId String?  // null = the system (an escalation)
  at       DateTime @default(now())

  @@index([ticketId, at])
  @@schema("ops")
}

// ───────────────────────────── M-07 / M-08 · finance & procurement ─────────────────────────────

/// The chart of accounts (M-07, 4 Nov): the five fixed roots, the accountant's tree under them, and sub-accounts added later.
/// Safes and banks are accounts in the same tree (kind set). Balances are live: the sum of the journal lines.
model Account {
  id         String        @id @default(cuid())
  code       String        @unique // 1 · 11 · 111 · 11101 — a child's code starts with its parent's
  name       String
  parentId   String?
  parent     Account?      @relation("AccountTree", fields: [parentId], references: [id])
  children   Account[]     @relation("AccountTree")
  nature     String        // dr · cr (from the root: assets and expenses debit)
  kind       String?       // treasury · bank · wallet: the cash accounts vouchers pay from and into
  fixed      Boolean       @default(false) // the seeded chart: can't be removed
  cap        Decimal?      @db.Decimal(14, 2) // petty-cash ceiling
  /// the person a 131 (سلف) / 134 (عهد) sub-account belongs to (M-07 9.3)
  holderId   String?
  budget     BudgetLine?
  movesFrom  TreasuryMove[] @relation("MoveFrom")
  movesTo    TreasuryMove[] @relation("MoveTo")
  movesOn    TreasuryMove[] @relation("MoveAccount")
  archivedAt DateTime?
  createdAt  DateTime      @default(now())
  payments   Payment[]
  lines      JournalLine[]
  purchases  Purchase[]    @relation("PurchaseLine")
  paidFor    Purchase[]    @relation("PurchasePaidFrom")

  @@index([parentId])
  @@schema("finance")
}

/// One double-entry journal entry (M-07 9.5): every movement posts one, debit = credit.
model JournalEntry {
  id          String        @id @default(cuid())
  no          Int           @unique @default(autoincrement()) // shown as JV-<no>
  date        DateTime      // the day it counts for (UTC midnight of the Cairo day)
  nature      String        // صرف نقدية · توريد نقدية · تحويل · رصيد افتتاحي · قيد يدوي …
  source      String        // opening · manual · voucher …
  sourceId    String?
  memo        String
  createdById String
  createdAt   DateTime      @default(now())
  lines       JournalLine[]

  @@index([date])
  @@index([source, sourceId])
  @@schema("finance")
}

model JournalLine {
  id        String       @id @default(cuid())
  entryId   String
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String
  account   Account      @relation(fields: [accountId], references: [id])
  debit     Decimal      @default(0) @db.Decimal(14, 2)
  credit    Decimal      @default(0) @db.Decimal(14, 2)

  @@index([entryId]) // 13.3: an entry's lines (journal, ledger, every voucher) - Postgres doesn't index FKs itself
  @@index([accountId])
  @@schema("finance")
}

model BudgetLine {
  id        String     @id @default(cuid())
  name      String     @unique
  kind      String     // admin · selling
  budget    Decimal    @db.Decimal(14, 2)
  spent     Decimal    @default(0) @db.Decimal(14, 2)
  /// the expense account it budgets (M-07 9.2): spent = that account's movements inside the period
  accountId String?    @unique
  account   Account?   @relation(fields: [accountId], references: [id])
  period    String     @default("month") // month · quarter · year
  alert     Int        @default(80) // «نبّهني عند %»
  active    Boolean    @default(true)
  /// who answers for the line: gets its alerts with the accountant (9.9)
  ownerId   String?

  @@schema("finance")
}

/// M-08 · a purchase / payment request: Pending → Approved → Settled («اتسوّى» by procurement) → Posted (finance's
/// payment voucher, 10.2), or Rejected with the reason. Procurement never moves a balance (4 Nov meeting).
model Purchase {
  id           String    @id @default(cuid())
  no           Int       @unique @default(autoincrement()) // shown as PR-<no>
  item         String
  amount       Decimal   @db.Decimal(14, 2)
  /// the line: an expense account (5…) from the chart; its budget is the BudgetLine on that account
  accountId    String
  account      Account   @relation("PurchaseLine", fields: [accountId], references: [id])
  vendor       String?
  attachments  String[]  // File ids: a receipt or two quotes, required over 10,000 EGP
  status       String    @default("Pending") // Pending · Approved · Rejected · Settled · Posted
  decidedById  String?
  decidedAt    DateTime?
  rejectReason String?
  /// the cash account procurement says it paid from: a suggestion for finance
  paidFromId   String?
  paidFrom     Account?  @relation("PurchasePaidFrom", fields: [paidFromId], references: [id])
  settledById  String?
  settledAt    DateTime?
  moveId       String?   @unique // finance's payment voucher once posted
  move         TreasuryMove? @relation(fields: [moveId], references: [id])
  postedById   String?
  postedAt     DateTime?
  remindedAt   DateTime? // the approvers' one-working-day reminder went out (2.4)
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([createdById])
  @@index([accountId])
  @@schema("finance")
}

model Contract {
  id           String        @id @default(cuid())
  code         String        @unique
  dealId       String        @unique
  startsOn     DateTime      @db.Date
  endsOn       DateTime      @db.Date
  value        Decimal       @db.Decimal(14, 2)
  escalation   Decimal       @default(0) @db.Decimal(5, 2)
  status       String        @default("Active")
  installments Installment[]

  @@schema("finance")
}

model Installment {
  id         String    @id @default(cuid())
  contractId String
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  dueOn      DateTime  @db.Date
  amount     Decimal   @db.Decimal(14, 2)
  paid       Decimal   @default(0) @db.Decimal(14, 2)

  @@schema("finance")
}

// ───────────────────────────── M-12 · KPI cards ─────────────────────────────

/// One person's card for one quarter (M-12 3.1). followerId null = the owners follow it.
model KpiCard {
  id          String    @id @default(cuid())
  quarter     String    // "2026-Q4"
  employeeId  String
  employee    Employee  @relation("KpiOwner", fields: [employeeId], references: [id])
  followerId  String?
  follower    Employee? @relation("KpiFollower", fields: [followerId], references: [id])
  payBase     String    @default("bonus") // salary · bonus
  payPeriod   String    @default("quarter") // month · quarter
  payAmount   Decimal?  @db.Decimal(14, 2) // the bonus; null = one month's salary (11.4)
  approvedBy  String?
  approvedAt  DateTime?
  finalScore  Decimal?  @db.Decimal(6, 2) // saved when the quarter ends: the past quarters' results
  finalAmount Decimal?  @db.Decimal(14, 2)
  plan        String?   // improvement plan under 70%
  midAlertAt  DateTime? // 11.6: the mid-quarter check ran for this card (once)
  items       KpiItem[]

  @@unique([quarter, employeeId])
  @@schema("kpi")
}

/// One item of a card. Exactly where its number comes from (meeting 4 Nov · 11.11): `method` system (a metric key from
/// the catalog in @places/domain + its `params`: period, kind, minutes…), report (handed in: `report` names the report
/// that delivers it, null = «سلّمت» on the card; `required` times in the quarter) or manual (typed by `enteredBy`:
/// "follower", role keys or user ids). `key` stays when the item is renamed or copied to a new quarter (11.12).
model KpiItem {
  id         String        @id @default(cuid())
  key        String        @default(cuid())
  cardId     String
  card       KpiCard       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  position   Int
  title      String
  weight     Int
  targetText String
  source     String        @default("") // the client's «المصدر» column, as written
  method     String        // system · report · manual
  module     String?       // M-01…M-12, shown next to the method
  direction  String        @default("at-least") // at-least · at-most
  goal       Decimal       @db.Decimal(14, 2)
  metric     String?
  params     Json          @default("{}")
  enteredBy  String[]      @default(["follower"])
  report     String?
  required   Int?
  value      Decimal?      @db.Decimal(14, 2) // the manual entry, or the system's latest figure (the daily job, 11.5)
  baseline   Decimal?      @db.Decimal(14, 2) // October 2026's measure for the growth items
  deliveries KpiDelivery[]

  @@unique([cardId, position])
  @@schema("kpi")
}

model KpiBands {
  id         String @id @default("default")
  top        Int    @default(100)
  full       Int    @default(96)
  partial    Int    @default(70)
  low        Int    @default(50)
  rewardPct  Int    @default(15)
  cutPct     Int    @default(15)

  @@schema("kpi")
}

// ───────────────────────────── M-13 / M-14 · settings, notifications, audit ─────────────────────────────

/// Official holidays as ranges «من … لحد …» (an Eid is several days · 1.29); every day in between is off for the SLA.
model Holiday {
  id    String   @id @default(cuid())
  from  DateTime @db.Date
  to    DateTime @db.Date
  label String

  @@index([from])
  @@schema("system")
}

model Setting {
  key       String   @id // areas, channels, companyCategories, slaRules, deductionTiers, approvalLimit…
  value     Json
  updatedAt DateTime @updatedAt

  @@schema("system")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  text      String
  link      String?
  important Boolean   @default(false) // stays until read
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@schema("system")
}

model NotificationRule {
  event    String   @id // see NOTIFICATION_EVENTS in @places/domain
  toRoles  String[]
  channels String[] // app · push · email

  @@schema("system")
}

/// Every create / update / delete / money change: who, when, what, before → after (Q50).
enum FileStatus {
  PENDING  // link handed out, the browser hasn't finished uploading
  READY    // uploaded and checked (size and type match what was asked)
  REJECTED // the uploaded object didn't match: deleted from storage

  @@schema("system")
}

/// Every stored object (photos, PDFs, receipts, sheets). The bytes live in S3/MinIO under `key`; this is the record.
model File {
  id           String     @id @default(cuid())
  key          String     @unique // <yyyy>/<mm>/<id>.<ext> in the bucket: never built from the uploaded name
  name         String     // the original file name, shown on download
  mime         String
  size         Int        // bytes, as declared before upload and checked after
  status       FileStatus @default(PENDING)
  uploadedById String
  entity       String?    // what it belongs to, e.g. "Unit" + its id; set by the module that uses it
  entityId     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([entity, entityId])
  @@index([status, createdAt]) // #209: the nightly sweep of PENDING uploads
  @@index([uploadedById])
  @@schema("system")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  at        DateTime @default(now())
  userId    String?
  module    String
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  ip        String?
  userAgent String? // the device (M-09 2.1 step 5)

  @@index([module, at])
  @@index([userId, at])
  @@index([entity, entityId])
  @@schema("system")
}

/// M-05 7.12 · a name in a fingerprint sheet that matched nobody: waits for HR to link it.
model FingerprintUnmatched {
  id           String   @id @default(cuid())
  name         String
  day          DateTime @db.Date
  checkIn      String?  // HH:MM, Cairo
  checkOut     String?
  uploadedById String
  createdAt    DateTime @default(now())

  @@unique([name, day])
  @@schema("hr")
}

/// A sheet / device name HR linked to an employee once; the next sheets match it by itself.
model FingerprintAlias {
  name       String   @id // normalised (normName)
  employeeId String
  createdAt  DateTime @default(now())

  @@schema("hr")
}

/// M-05 7.4 · an Excuse: a ticket to the Team Leader, then HR; its number in the month decides what it costs.
model ExcuseRequest {
  id          String    @id @default(cuid())
  employeeId  String
  day         DateTime  @db.Date
  reason      String
  number      Int       // its number in the month (1, 2, 3 …)
  status      String    @default("pending_tl") // pending_tl · approved_tl · confirmed · rejected · refused
  ticketId    String?   @unique
  tlUserId    String?
  hrUserId    String?
  rejectReason String?
  createdById String
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?

  @@index([employeeId, day])
  @@schema("hr")
}

/// M-08 3.1 · the office assets register Mokhtar keeps (KPI M-12: updated and reviewed every month).
model OfficeAsset {
  id          String    @id @default(cuid())
  name        String
  place       String    @default("")
  needsRepair Boolean   @default(false) // «محتاج صيانة»; false = «سليم»
  archivedAt  DateTime? // taken off the register (sold, thrown away): kept for the audit trail
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([archivedAt])
  @@schema("ops")
}

/// Every «اتراجع الشهر ده» on the register: who reviewed it and when (the KPI reads the latest).
model OfficeAssetReview {
  id           String   @id @default(cuid())
  reviewedById String
  at           DateTime @default(now())

  @@index([at])
  @@schema("ops")
}

/// M-08 3.1 · the office boys' rota by area (KPI M-12: ≥90% compliance, rated by Nancy on Mokhtar's card).
model OfficeBoyShift {
  id        String   @id @default(cuid())
  area      String   // «الدور الأرضي + الاستقبال»
  name      String   // the office boy: not a system user
  slots     String   // «9:00 · 13:00 · 17:00» or «قبل كل اجتماع»
  createdAt DateTime @default(now())

  @@schema("ops")
}

/// M-07 · one treasury voucher (9.2, 9.3, 9.11): pay · receive · transfer · advance · custody · settle, with its journal entry.
model TreasuryMove {
  id          String   @id @default(cuid())
  no          Int      @unique @default(autoincrement())
  kind        String
  date        DateTime
  fromId      String?
  from        Account? @relation("MoveFrom", fields: [fromId], references: [id])
  toId        String?
  to          Account? @relation("MoveTo", fields: [toId], references: [id])
  /// the expense / revenue / the person's 131 or 134 account
  accountId   String?
  account     Account? @relation("MoveAccount", fields: [accountId], references: [id])
  /// settle: the expense the custody was spent on
  expenseId   String?
  amount      Decimal  @db.Decimal(14, 2)
  spent       Decimal? @db.Decimal(14, 2)
  returned    Decimal? @db.Decimal(14, 2)
  party       String   // who received / paid (an employee's name, a vendor, a company)
  partyId     String?  // the employee (user id) for advances and custody
  ref         String?
  memo        String
  entryId     String   @unique
  createdById String
  createdAt   DateTime @default(now())
  purchase    Purchase?
  claim       Claim?

  @@index([fromId])
  @@index([toId])
  @@index([date])
  @@schema("finance")
}

/// M-07 · a month closed by hand (9.8): «اقفل الشهر» / «اقفل الربع». Months before today's close by themselves.
model FinancePeriod {
  month       String   @id // 2026-11
  status      String   // month · quarter
  closedById  String
  closedAt    DateTime @default(now())

  @@schema("finance")
}

/// M-07 · a fixed bill (9.16): never pays by itself — on its day the accountant approves and pays, or skips the month.
model RecurringBill {
  id           String   @id @default(cuid())
  name         String
  vendor       String
  accountId    String   // the expense line (5…)
  fromId       String   // the usual safe / bank
  amount       Decimal  @db.Decimal(14, 2) // the usual amount (the voucher can differ)
  day          Int      // 1–28
  active       Boolean  @default(true)
  /// the month its «ميعاد فاتورة» notification went out (the job runs daily; once a month)
  notifiedFor  String?
  createdById  String
  createdAt    DateTime @default(now())
  months       RecurringBillMonth[]

  @@schema("finance")
}

model RecurringBillMonth {
  id        String        @id @default(cuid())
  billId    String
  bill      RecurringBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  month     String        // 2026-11
  status    String        // paid · skipped
  moveId    String?       // the payment voucher
  reason    String?       // why not this month
  byId      String
  at        DateTime      @default(now())

  @@unique([billId, month])
  @@schema("finance")
}

/// M-07 · one month's payroll (9.14): paid once, as one voucher «صرف مرتبات» with one entry.
model PayrollRun {
  id          String        @id @default(cuid())
  month       String        @unique // 2026-11
  moveId      String        @unique
  fromId      String
  gross       Decimal       @db.Decimal(14, 2)
  net         Decimal       @db.Decimal(14, 2)
  createdById String
  at          DateTime      @default(now())
  lines       PayrollLine[]

  @@schema("finance")
}

model PayrollLine {
  id         String     @id @default(cuid())
  runId      String
  run        PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId     String
  name       String
  line       String     // admin · sales
  salary     Decimal    @db.Decimal(14, 2)
  attendance Decimal    @db.Decimal(14, 2)
  advance    Decimal    @db.Decimal(14, 2)
  net        Decimal    @db.Decimal(14, 2)

  @@index([runId])
  @@index([userId])
  @@schema("finance")
}

/// «يتخصم كام الشهر ده» from a person's advance (9.3 / 9.14); the next month starts with the same choice.
model AdvanceDeduction {
  id       String   @id @default(cuid())
  userId   String
  month    String
  amount   Decimal  @db.Decimal(14, 2)
  byId     String
  at       DateTime @default(now())

  @@unique([userId, month])
  @@schema("finance")
}

/// 12.12 · who claims and receipts go out under (Places · ذراين للدعاية والإعلان): the logo and the bank details printed on a claim.
model Entity {
  id          String   @id // places · zrain
  name        String
  logoFileId  String? // a system.File (0.9)
  bank        String   @default("")
  accountName String   @default("")
  accountNo   String   @default("")
  iban        String   @default("")
  claims      Claim[]
  updatedAt   DateTime @updatedAt

  @@schema("system")
}

/// 12.12 · the admin's wording for a document; no row = the default in @places/domain (DOC_DEFAULTS).
model DocTemplate {
  kind      String   @id // claim · receipt
  title     String
  body      String
  closing   String
  updatedAt DateTime @updatedAt

  @@schema("system")
}

/// M-07 9.17 · a claim to a company → the e-invoice → the cash receipt (from the templates, with the stamp).
model Claim {
  id             String        @id @default(cuid())
  no             Int           @unique @default(autoincrement()) // CL-<no>
  dealId         String? // the deal it comes from: deals (5.1/5.2) aren't built yet, so it stays empty for now
  company        String // as it is written on the claim
  unit           String
  unitInfo       String
  amount         Decimal       @db.Decimal(14, 2)
  side           String // client · owner
  kind           String // نوع العمولة, e.g. «عمولة تأجير»
  entityId       String
  entity         Entity        @relation(fields: [entityId], references: [id])
  note           String?
  status         String        @default("requested")
  why            String? // the rejection's reason
  requestedById  String
  issuedById     String?
  issuedAt       DateTime?
  approvedAt     DateTime? // the client approved it
  receiptAskedAt DateTime? // sales: the client paid, make the receipt
  einvoiceNo     String?
  einvoiceDate   DateTime?     @db.Date
  moveId         String?       @unique // the receive voucher (9.11)
  move           TreasuryMove? @relation(fields: [moveId], references: [id])
  receiptNo      Int?          @unique // RC-<n>, serial
  payMethod      String?
  paidAt         DateTime?     @db.Date
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([requestedById])
  @@schema("finance")
}

/// The quarters the KPI cards run in (11.1 · 11.11). The latest one is the current quarter; a new one starts from a copy
/// of the last one's cards (same items and weights, nothing achieved) and the old cards keep their final results.
model KpiQuarter {
  id         String    @id // "2026-Q4"
  status     String    @default("open") // open · closed
  startedAt  DateTime  @default(now())
  closedAt   DateTime?
  closedById String?
  /// 11.7: the Office Manager approved the quarterly sheets (PDF) and they were emailed
  sheetsAt   DateTime?
  sheetsById String?

  @@schema("kpi")
}

/// 11.13 · a Farming / Approach a salesperson plans (where, when); after its time he says whether he did it and what
/// came of it (Farming: brought something new + a note · Approach: the companies). The Farming item counts the done
/// ones on the day they happened (`at`).
model SalesActivity {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  kind       String    // Farming · Approach
  place      String
  at         DateTime
  status     String    @default("planned") // planned · done · notDone
  got        Boolean?
  note       String?
  companies  String[]  @default([])
  doneAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([employeeId, at])
  @@schema("kpi")
}

/// A hand-in on a report item (11.2): a link or an uploaded file, and when.
model KpiDelivery {
  id     String   @id @default(cuid())
  itemId String
  item   KpiItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  at     DateTime @default(now())
  byId   String
  link   String?
  fileId String?

  @@schema("kpi")
}

/// 11.10 · a scheduled report (meeting 4 Nov): the system sends it (auto, `content` = what it builds) or people hand it in
/// (handin: `preparedBy`, a reminder `remindMin` before, `lateNotify` told after). Names are user ids, role keys or
/// "follower". `money` keeps it from the KPI watcher. `daily` = the daily report of every team (11.12).
/// A KpiItem whose `report` is this id counts the on-time hand-ins.
model ScheduledReport {
  id         String         @id @default(cuid())
  name       String
  on         Boolean        @default(true)
  kind       String // auto · handin
  freq       String // daily · weekly · monthly · quarterly
  day        Int            @default(0) // weekday 0–6 (Sunday = 0) or day of the month
  time       String // "HH:MM" Cairo
  fmt        String         @default("جوه السيستم")
  content    String? // auto: "performance" (11.10 the sales performance report)
  preparedBy String[]       @default([])
  recipients String[]       @default([])
  remindMin  Int            @default(60)
  lateNotify String[]       @default([])
  money      Boolean        @default(false)
  daily      Boolean        @default(false)
  createdAt  DateTime       @default(now()) // first run: periods due before this aren't sent or chased
  handIns    ReportHandIn[]
  runs       ReportRun[]

  @@schema("kpi")
}

/// One person's hand-in for one period (its due date): when, and the reminder / late notice the worker sent once.
model ReportHandIn {
  id         String          @id @default(cuid())
  reportId   String
  report     ScheduledReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId     String
  period     String // "YYYY-MM-DD", the due date
  at         DateTime?
  remindedAt DateTime?
  lateAt     DateTime?

  @@unique([reportId, userId, period])
  @@schema("kpi")
}

/// An auto report the system built: its rows, listed under the report and downloadable as Excel.
model ReportRun {
  id       String          @id @default(cuid())
  reportId String
  report   ScheduledReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  period   String
  at       DateTime        @default(now())
  title    String
  rows     Json

  @@unique([reportId, period])
  @@schema("kpi")
}

/// 11.12 · one person's daily report: what he typed (KpiItem key or extra field id → value) and when he handed it in.
model DailyReport {
  id     String   @id @default(cuid())
  userId String
  day    DateTime @db.Date
  values Json     @default("{}")
  note   String   @default("")
  at     DateTime @default(now())

  @@unique([userId, day])
  @@schema("kpi")
}

/// 11.12 · an extra field on one person's daily report (a number or a sentence), added by the admin / the KPI watcher.
model DailyReportField {
  id       String @id @default(cuid())
  userId   String
  label    String
  type     String // number · text
  position Int    @default(0)

  @@index([userId])
  @@schema("kpi")
}

/// 11.8 · a salesperson's target for a month: value (his share of collections), Transactions and visits. A change in the
/// middle of the month waits in `pending` until someone with «reports: approve» accepts it.
model SalesTarget {
  id         String  @id @default(cuid())
  employeeId String
  month      String // "YYYY-MM"
  value      Decimal @db.Decimal(14, 2)
  deals      Int     @default(0)
  visits     Int     @default(0)
  pending    Json? // { value, deals, visits, by }

  @@unique([employeeId, month])
  @@schema("kpi")
}
