{
  "name": "@places/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "node --env-file=../../.env prisma/seed.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@places/domain": "workspace:*",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "prisma": "^7.10.1",
    "typescript": "^6.0.3",
    "@node-rs/argon2": "^2.0.2",
    "@types/web-push": "3.6.4"
  }
}
