# Copy to .env and fill in. Never commit the real .env.
NODE_ENV=development
TZ=Africa/Cairo

# database / queues (docker compose in infra/docker gives these locally)
DATABASE_URL=postgresql://places:places@localhost:5432/places
REDIS_URL=redis://localhost:6379

# auth — generate with: openssl rand -base64 48
SESSION_SECRET=change-me
SESSION_TTL_HOURS=12

# web
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000

# files: versitygw on our own server, plain files on disk (infra/server/README.md); locally pnpm files:local or infra:up
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=places
S3_ACCESS_KEY=places
S3_SECRET_KEY=places-secret

# email (Mailpit locally on http://localhost:8025)
# SMTP_URL=smtp://localhost:1025   # Mailpit (Docker); leave commented to write dev emails to .local/outbox/
MAIL_FROM="Places ERP <notifications@places.example>"

# web push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:notifications@places.com   # who the push services contact; empty keys = push off

# observability
# optional
SENTRY_DSN=

# dev only: password for every seeded account (pnpm db:seed). Never set in production.
SEED_DEV_PASSWORD=
